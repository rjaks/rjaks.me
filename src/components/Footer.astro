---
// src/components/Footer.astro
---

<footer class="w-full border-t border-[var(--color-border)] bg-[var(--color-bg)] py-6 mt-auto">
  <div class="max-w-4xl w-full mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs text-[var(--color-text-secondary)]">
    <!-- Left: Status & Identity -->
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-[var(--color-prompt)] animate-pulse"></span>
      <span>Adrian Reforsado (<span class="text-[var(--color-accent)]">rjaks</span>)</span>
    </div>

    <!-- Center: Shortcuts Help Hint & Guestbook Trigger -->
    <div class="flex items-center gap-2.5 text-[11px] text-[var(--color-text-muted)]">
      <button 
        class="open-chat-trigger text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors cursor-pointer flex items-center gap-1 font-mono"
        title="Open Community Chat (Alt+C)"
      >
        <span class="text-[var(--color-prompt)] font-bold">&gt;</span>
        <span>chat / guestbook</span>
        <kbd class="hidden sm:inline-block text-[10px]">alt+c</kbd>
      </button>
      <span class="hidden md:inline text-[var(--color-border)]">|</span>
      <div class="hidden md:flex items-center gap-1.5">
        <span>Press</span>
        <kbd>?</kbd>
        <span>shortcuts</span>
      </div>
    </div>

    <!-- Right: Quick Links -->
    <div class="flex items-center gap-4">
      <a 
        href="https://github.com/rjaks" 
        target="_blank" 
        rel="noopener noreferrer"
        class="hover:text-[var(--color-accent)] transition-colors flex items-center gap-1"
      >
        <span>GitHub</span>
        <span class="ext-arrow">↗</span>
      </a>
      <a 
        href="https://linkedin.com/in/adreforsado" 
        target="_blank" 
        rel="noopener noreferrer"
        class="hover:text-[var(--color-accent)] transition-colors flex items-center gap-1"
      >
        <span>LinkedIn</span>
        <span class="ext-arrow">↗</span>
      </a>
      <a 
        href="mailto:contact@rjaks.me" 
        class="hover:text-[var(--color-accent)] transition-colors"
      >
        Email
      </a>
    </div>
  </div>
</footer>

