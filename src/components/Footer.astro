---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-[var(--color-border)] bg-[var(--color-bg)] py-6 mt-auto">
  <div class="container-custom flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs text-[var(--color-text-secondary)]">
    <!-- Left: Copyright & Location -->
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-[var(--color-prompt)] animate-pulse"></span>
      <span>&copy; {currentYear} Adrian Reforsado (<span class="text-[var(--color-accent)]">rjaks</span>)</span>
    </div>

    <!-- Center: Shortcuts Help Hint -->
    <div class="hidden md:flex items-center gap-1.5 text-[11px] text-[var(--color-text-muted)]">
      <span>Tip: Press</span>
      <kbd>?</kbd>
      <span>for terminal shortcuts</span>
    </div>

    <!-- Right: Quick Links -->
    <div class="flex items-center gap-4">
      <a 
        href="https://github.com/rjaks" 
        target="_blank" 
        rel="noopener noreferrer"
        class="hover:text-[var(--color-accent)] transition-colors flex items-center gap-1"
      >
        <span>GitHub</span>
        <span class="ext-arrow">↗</span>
      </a>
      <a 
        href="https://linkedin.com" 
        target="_blank" 
        rel="noopener noreferrer"
        class="hover:text-[var(--color-accent)] transition-colors flex items-center gap-1"
      >
        <span>LinkedIn</span>
        <span class="ext-arrow">↗</span>
      </a>
      <a 
        href="mailto:contact@rjaks.me" 
        class="hover:text-[var(--color-accent)] transition-colors"
      >
        Email
      </a>
    </div>
  </div>
</footer>

