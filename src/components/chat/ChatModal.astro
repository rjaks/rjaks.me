---
// src/components/chat/ChatModal.astro
---

<dialog 
  id="chat-modal" 
  class="fixed inset-0 m-auto z-50 p-2 sm:p-4 bg-transparent border-none text-inherit backdrop:bg-black/75 backdrop:backdrop-blur-xs open:flex items-center justify-center overflow-visible"
  style="width: min(94vw, 540px); max-width: 540px;"
>
  <div class="terminal-panel relative w-full bg-[var(--color-surface)] border border-[var(--color-border)] shadow-2xl p-4 sm:p-5 text-[var(--color-text-primary)] font-mono text-xs overflow-hidden flex flex-col rounded-md">
    <!-- Top Modal Header -->
    <div class="flex items-center justify-between pb-3 mb-3 border-b border-[var(--color-border)]">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-[var(--color-accent)] animate-pulse"></span>
        <h2 class="font-bold text-xs sm:text-sm tracking-tight text-[var(--color-text-primary)]">
          rjaks:~$ chat --community
        </h2>
      </div>

      <!-- Window Controls -->
      <div class="flex items-center gap-2">
        <button 
          id="chat-refresh-btn"
          class="p-1 rounded-xs border border-[var(--color-border)] hover:border-[var(--color-accent)] text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors cursor-pointer"
          title="Refresh messages"
          aria-label="Refresh messages"
        >
          <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
            <path d="M3 3v5h5"></path>
            <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"></path>
            <path d="M16 21h5v-5"></path>
          </svg>
        </button>

        <form method="dialog">
          <button 
            id="chat-btn-close"
            class="text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] font-mono text-[11px] cursor-pointer px-2 py-0.5 border border-[var(--color-border)] rounded-xs hover:border-[var(--color-accent)] transition-colors"
          >
            ESC [x]
          </button>
        </form>
      </div>
    </div>

    <!-- Messages Stream -->
    <div 
      id="chat-messages-container" 
      class="h-64 sm:h-72 overflow-y-auto pr-1.5 space-y-2 mb-3 scrollbar-thin divide-y divide-[var(--color-border-subtle)]"
    >
      <div class="py-8 text-center text-[var(--color-text-muted)] italic text-xs">
        loading messages...
      </div>
    </div>

    <!-- Input & Send Area -->
    <form id="chat-send-form" class="mt-auto space-y-2 pt-3 border-t border-[var(--color-border)]">
      <!-- Invisible honeypot field for bot protection -->
      <input type="text" name="website" id="chat-honeypot" class="hidden" tabindex="-1" autocomplete="off" />

      <!-- Two inputs: Handle & Message -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
        <div class="sm:col-span-1 flex items-center gap-1 bg-[var(--color-bg)] border border-[var(--color-border)] rounded-xs px-2.5 py-1.5 focus-within:border-[var(--color-accent)] transition-colors">
          <span class="text-[var(--color-prompt)] font-bold select-none text-xs">@</span>
          <input 
            type="text" 
            id="chat-nick-input" 
            placeholder="name" 
            maxlength="24"
            autocomplete="name"
            class="w-full bg-transparent text-[var(--color-text-primary)] placeholder-[var(--color-text-muted)] font-mono text-xs focus:outline-none"
          />
        </div>

        <div class="sm:col-span-2 flex items-center gap-1.5 bg-[var(--color-bg)] border border-[var(--color-border)] rounded-xs px-2.5 py-1.5 focus-within:border-[var(--color-accent)] transition-colors">
          <input 
            type="text" 
            id="chat-input" 
            placeholder="leave a message..." 
            maxlength="280"
            autocomplete="off"
            class="w-full bg-transparent text-[var(--color-text-primary)] placeholder-[var(--color-text-muted)] font-mono text-xs focus:outline-none"
          />
          <button 
            type="submit" 
            id="chat-submit-btn" 
            class="shrink-0 text-[11px] px-2.5 py-0.5 rounded-xs bg-[var(--color-border-subtle)] hover:bg-[var(--color-accent)] hover:text-black font-semibold text-[var(--color-text-secondary)] border border-[var(--color-border)] transition-colors cursor-pointer disabled:opacity-50"
          >
            Send ↵
          </button>
        </div>
      </div>

      <div class="flex items-center justify-between text-[10px] text-[var(--color-text-muted)] px-0.5">
        <span id="chat-error-msg" class="text-rose-400 font-mono"></span>
        <span id="chat-char-counter" class="ml-auto font-mono">280</span>
      </div>
    </form>
  </div>
</dialog>

<script>
  interface ChatMessage {
    id: string;
    nickname: string;
    message: string;
    created_at: number;
  }

  function initCommunityChat() {
    const modal = document.getElementById('chat-modal') as HTMLDialogElement | null;
    if (!modal) return;

    const messagesContainer = document.getElementById('chat-messages-container');
    const nickInput = document.getElementById('chat-nick-input') as HTMLInputElement | null;
    const msgInput = document.getElementById('chat-input') as HTMLInputElement | null;
    const form = document.getElementById('chat-send-form') as HTMLFormElement | null;
    const honeypot = document.getElementById('chat-honeypot') as HTMLInputElement | null;
    const refreshBtn = document.getElementById('chat-refresh-btn');
    const errorMsg = document.getElementById('chat-error-msg');
    const charCounter = document.getElementById('chat-char-counter');
    const submitBtn = document.getElementById('chat-submit-btn') as HTMLButtonElement | null;

    let pollInterval: number | null = null;
    let cachedMessages: ChatMessage[] = [];
    let isSubmitting = false;

    // Load saved handle from localStorage if present
    const savedNick = localStorage.getItem('rjaks_chat_nickname');
    if (savedNick && nickInput && !nickInput.value) {
      nickInput.value = savedNick;
    }

    function formatTime(ts: number): string {
      const d = new Date(ts);
      const hours = d.getHours().toString().padStart(2, '0');
      const mins = d.getMinutes().toString().padStart(2, '0');
      return `${hours}:${mins}`;
    }

    function getAvatarSvg(name: string): string {
      let hash = 0;
      for (let i = 0; i < name.length; i++) {
        hash = (hash << 5) - hash + name.charCodeAt(i);
        hash |= 0;
      }
      const colors = ['#f59e0b', '#10b981', '#3b82f6', '#8b5cf6', '#ec4899', '#06b6d4', '#eab308'];
      const color = colors[Math.abs(hash) % colors.length];
      let rects = '';
      for (let y = 0; y < 5; y++) {
        for (let x = 0; x < 3; x++) {
          if ((Math.abs(hash) >> (y * 3 + x)) & 1) {
            rects += `<rect x="${x * 2}" y="${y * 2}" width="2" height="2" fill="${color}"/>`;
            if (x < 2) {
              rects += `<rect x="${(4 - x) * 2}" y="${y * 2}" width="2" height="2" fill="${color}"/>`;
            }
          }
        }
      }
      return `<svg class="w-3.5 h-3.5 rounded-xs shrink-0 bg-[var(--color-surface)] border border-[var(--color-border)] p-[1px]" viewBox="0 0 10 10">${rects}</svg>`;
    }

    function renderMessages(messages: ChatMessage[]) {
      if (!messagesContainer) return;
      cachedMessages = messages;

      if (messages.length === 0) {
        messagesContainer.innerHTML = `
          <div class="py-8 text-center text-[var(--color-text-muted)] font-mono text-xs">
            no messages yet. be the first to leave one!
          </div>
        `;
        return;
      }

      const isAtBottom = messagesContainer.scrollHeight - messagesContainer.scrollTop <= messagesContainer.clientHeight + 40;

      messagesContainer.innerHTML = messages.map((m) => {
        const timeStr = formatTime(m.created_at);
        return `
          <div class="pt-2.5 pb-1 text-xs font-mono">
            <div class="flex items-center justify-between text-[11px] mb-1">
              <div class="flex items-center gap-1.5">
                ${getAvatarSvg(m.nickname)}
                <span class="font-bold text-[var(--color-accent)]">${m.nickname}</span>
              </div>
              <span class="text-[10px] text-[var(--color-text-muted)] select-none">${timeStr}</span>
            </div>
            <p class="text-[var(--color-text-primary)] break-words whitespace-pre-wrap leading-relaxed">${m.message}</p>
          </div>
        `;
      }).join('');

      if (isAtBottom) {
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
      }
    }

    async function fetchMessages() {
      try {
        const res = await fetch('/api/chat', { cache: 'no-store' });
        if (!res.ok) throw new Error('Network error');
        const data = await res.json();

        if (data.ok && Array.isArray(data.messages)) {
          const lastOldId = cachedMessages[cachedMessages.length - 1]?.id;
          const lastNewId = data.messages[data.messages.length - 1]?.id;
          if (cachedMessages.length !== data.messages.length || lastOldId !== lastNewId) {
            renderMessages(data.messages);
          }
        }
      } catch {
        // Silently fail during poll
      }
    }

    function startPolling() {
      if (pollInterval) clearInterval(pollInterval);
      fetchMessages();
      pollInterval = window.setInterval(() => {
        if (modal?.open) {
          fetchMessages();
        }
      }, 4000);
    }

    function stopPolling() {
      if (pollInterval) {
        clearInterval(pollInterval);
        pollInterval = null;
      }
    }

    msgInput?.addEventListener('input', () => {
      const remaining = 280 - (msgInput.value.length || 0);
      if (charCounter) charCounter.textContent = remaining.toString();
      if (errorMsg) errorMsg.textContent = '';
    });

    nickInput?.addEventListener('input', () => {
      if (errorMsg) errorMsg.textContent = '';
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (isSubmitting || !msgInput || !nickInput) return;

      const nick = nickInput.value.trim();
      const rawMsg = msgInput.value.trim();

      if (!nick) {
        if (errorMsg) errorMsg.textContent = 'Please enter your name.';
        nickInput.focus();
        return;
      }

      if (!rawMsg) {
        if (errorMsg) errorMsg.textContent = 'Please enter a message.';
        msgInput.focus();
        return;
      }

      if (honeypot?.value) return;

      // Save entered nickname for convenience
      localStorage.setItem('rjaks_chat_nickname', nick);

      isSubmitting = true;
      if (submitBtn) submitBtn.disabled = true;
      if (errorMsg) errorMsg.textContent = '';

      const tempId = `temp-${Date.now()}`;
      const tempMsg: ChatMessage = {
        id: tempId,
        nickname: nick,
        message: rawMsg.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'),
        created_at: Date.now(),
      };
      renderMessages([...cachedMessages, tempMsg]);
      msgInput.value = '';
      if (charCounter) charCounter.textContent = '280';

      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            nickname: nick,
            message: rawMsg,
            honeypot: honeypot?.value || '',
          }),
        });

        const data = await res.json();
        if (!res.ok || !data.ok) {
          throw new Error(data.error || 'Failed to send');
        }

        fetchMessages();
      } catch (err: any) {
        if (errorMsg) {
          errorMsg.textContent = err?.message || 'Error sending message.';
        }
        renderMessages(cachedMessages.filter((m) => m.id !== tempId));
      } finally {
        isSubmitting = false;
        if (submitBtn) submitBtn.disabled = false;
        msgInput.focus();
      }
    });

    refreshBtn?.addEventListener('click', () => {
      fetchMessages();
    });

    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });

    modal.addEventListener('close', () => {
      stopPolling();
    });

    document.querySelectorAll('.open-chat-trigger').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!modal.open) {
          modal.showModal();
          startPolling();
          setTimeout(() => (nickInput?.value ? msgInput?.focus() : nickInput?.focus()), 100);
        }
      });
    });

    const originalShowModal = modal.showModal.bind(modal);
    modal.showModal = function () {
      originalShowModal();
      startPolling();
      setTimeout(() => (nickInput?.value ? msgInput?.focus() : nickInput?.focus()), 100);
    };

    if (window.location.hash === '#chat' && !modal.open) {
      modal.showModal();
    }
  }

  initCommunityChat();
  document.addEventListener('astro:page-load', initCommunityChat);
</script>
