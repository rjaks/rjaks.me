---
const pathname = Astro.url.pathname;
const navItems = [
  { href: '/work', label: 'Work', path: '~/work', key: 'w', active: pathname.startsWith('/work') || pathname.startsWith('/experience'), mobile: true },
  { href: '/projects', label: 'Projects', path: '~/projects', key: 'p', active: pathname.startsWith('/projects'), mobile: true },
  { href: '/writing', label: 'Writing', path: '~/writing', key: 'b', active: pathname.startsWith('/writing') || pathname.startsWith('/blog'), mobile: true },
  { href: '/skills', label: 'Skills', path: '~/skills', key: 's', active: pathname.startsWith('/skills'), mobile: false },
  { href: '/contact', label: 'Contact', path: '~/contact', key: '@', active: pathname.startsWith('/contact'), mobile: false },
];
---

<!-- Mobile & Tablet Top Header (< lg) -->
<header class="lg:hidden w-full border-b border-[var(--color-border)] bg-[var(--color-bg)]/90 backdrop-blur-md sticky top-0 z-40 transition-colors">
  <div class="max-w-4xl w-full mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between py-3">
    <!-- Brand / Shell Prompt -->
    <a 
      href="/" 
      class="group flex items-center gap-1.5 font-mono text-sm tracking-tight text-[var(--color-text-primary)] hover:text-[var(--color-accent)] transition-colors py-1 shrink-0"
      aria-label="Home"
    >
      <span class="text-[var(--color-prompt)] font-bold">rjaks:~$</span>
      <span class="text-[var(--color-text-primary)] group-hover:text-[var(--color-accent)] font-semibold">cd ~</span>
      <span class="terminal-cursor"></span>
    </a>

    <!-- Tablet Navigation (sm:flex, hidden on mobile < 640px) -->
    <div class="hidden sm:flex items-center gap-2 sm:gap-2.5 font-mono text-xs">
      <nav class="flex items-center gap-0.5 sm:gap-1" aria-label="Tablet Navigation">
        {navItems.map((item) => (
          <a 
            href={item.href} 
            class={`flex items-center gap-1 px-2 sm:px-2.5 py-1.5 rounded-sm transition-colors ${item.active ? 'text-[var(--color-accent)] font-bold bg-[var(--color-border-subtle)]' : 'text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:bg-[var(--color-border-subtle)]'}`}
          >
            <span>{item.label}</span>
          </a>
        ))}
        <button 
          class="open-wordle-trigger flex items-center gap-1 px-2 sm:px-2.5 py-1.5 rounded-sm transition-colors text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:bg-[var(--color-border-subtle)] cursor-pointer"
          aria-label="Play Wordle"
          title="Play Wordle (Alt+G)"
        >
          <span>wordle</span>
        </button>
      </nav>

      <div class="h-3.5 w-[1px] bg-[var(--color-border)]"></div>

      <!-- Theme Switcher Button -->
      <button 
        class="theme-toggle-btn flex items-center gap-1 p-1.5 rounded-sm text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] hover:bg-[var(--color-border-subtle)] transition-colors cursor-pointer"
        aria-label="Toggle dark/light theme"
        title="Toggle Theme (press 't')"
      >
        <svg class="w-3.5 h-3.5 hidden dark-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <svg class="w-3.5 h-3.5 hidden light-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3a6 6 0 0 0 9 9 9 0 1 1-9-9Z"></path>
        </svg>
        <kbd class="hidden md:inline-block text-[10px]">t</kbd>
      </button>

      <!-- Shortcuts modal button on tablet -->
      <button 
        class="open-shortcuts-trigger flex items-center gap-1 px-1.5 py-1 rounded-sm border border-[var(--color-border)] hover:border-[var(--color-accent)] text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors cursor-pointer text-[11px]"
        aria-label="View keyboard shortcuts"
        title="Open keyboard shortcuts cheat sheet"
      >
        <span>?</span>
      </button>
    </div>

    <!-- Mobile Header Actions (< sm) -->
    <div class="flex sm:hidden items-center gap-2 font-mono text-xs">
      <!-- Theme Switcher Button -->
      <button 
        class="theme-toggle-btn p-2 rounded-sm text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] hover:bg-[var(--color-border-subtle)] transition-colors cursor-pointer min-w-[36px] min-h-[36px] flex items-center justify-center border border-[var(--color-border)]"
        aria-label="Toggle dark/light theme"
        title="Toggle Theme"
      >
        <svg class="w-3.5 h-3.5 hidden dark-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <svg class="w-3.5 h-3.5 hidden light-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3a6 6 0 0 0 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>

      <!-- Mobile Terminal Menu Button -->
      <button 
        id="mobile-menu-toggle"
        class="flex items-center gap-1.5 px-3 py-1.5 rounded-sm border border-[var(--color-border)] text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)] hover:bg-[var(--color-border-subtle)] transition-colors cursor-pointer text-xs font-mono min-h-[36px]"
        aria-expanded="false"
        aria-controls="mobile-menu-drawer"
        aria-label="Toggle navigation menu"
      >
        <span class="text-[var(--color-prompt)] font-bold mobile-menu-indicator">&gt;</span>
        <span id="mobile-menu-label">menu</span>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Drawer (< sm) -->
  <div 
    id="mobile-menu-drawer" 
    class="sm:hidden hidden border-t border-[var(--color-border)] bg-[var(--color-bg)]/98 backdrop-blur-xl px-4 py-4 shadow-2xl transition-all duration-200 animate-in fade-in slide-in-from-top-2"
  >
    <!-- CLI Routes -->
    <nav class="space-y-1 font-mono text-xs" aria-label="Mobile Navigation">
      <div class="text-[10px] text-[var(--color-text-muted)] uppercase tracking-wider px-2 py-1 font-bold">
        Directory
      </div>
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class={`mobile-nav-link flex items-center justify-between px-3 py-2.5 rounded-sm transition-colors ${item.active ? 'text-[var(--color-accent)] font-bold bg-[var(--color-border-subtle)]' : 'text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:bg-[var(--color-border-subtle)]'}`}
        >
          <div class="flex items-center gap-2">
            <span class={item.active ? 'text-[var(--color-accent)] font-bold' : 'text-[var(--color-text-muted)]'}>
              {item.active ? '●' : '›'}
            </span>
            <span class="font-medium">{item.path}</span>
          </div>
          <span class="text-[11px] text-[var(--color-text-muted)] font-normal">{item.label}</span>
        </a>
      ))}
    </nav>

    <!-- Divider -->
    <div class="my-3 border-t border-[var(--color-border-subtle)]"></div>

    <!-- Quick Tools & Actions -->
    <div class="grid grid-cols-2 gap-2 font-mono text-xs">
      <button 
        class="open-wordle-trigger flex items-center justify-center gap-1.5 px-3 py-2 rounded-sm border border-[var(--color-border)] text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:border-[var(--color-accent)] hover:bg-[var(--color-border-subtle)] transition-colors cursor-pointer text-xs"
      >
        <span class="text-[var(--color-prompt)] font-bold">&gt;</span>
        <span>wordle</span>
      </button>
      <button 
        id="mobile-shortcuts-btn"
        class="flex items-center justify-center gap-1.5 px-3 py-2 rounded-sm border border-[var(--color-border)] text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:border-[var(--color-accent)] hover:bg-[var(--color-border-subtle)] transition-colors cursor-pointer text-xs"
      >
        <span>man ?</span>
      </button>
    </div>

    <!-- Email Contact Link -->
    <div class="mt-3 pt-2.5 border-t border-[var(--color-border-subtle)] flex items-center justify-between font-mono text-[11px] text-[var(--color-text-muted)]">
      <span>get in touch:</span>
      <a href="mailto:contact@rjaks.me" class="text-[var(--color-accent)] font-semibold hover:underline">
        contact@rjaks.me
      </a>
    </div>
  </div>
</header>

<!-- Desktop Terminal Sidebar (>= lg) -->
<aside 
  class="hidden lg:flex flex-col justify-between fixed left-0 top-0 h-screen w-60 xl:w-64 py-8 px-6 border-r border-[var(--color-border)] bg-[var(--color-bg)] select-none font-mono text-xs z-30 transition-colors"
  aria-label="Terminal Sidebar Navigation"
>
  <!-- Top: Brand & Navigation -->
  <div class="space-y-6">
    <!-- Brand / Shell Prompt -->
    <a 
      href="/" 
      class="group flex items-center gap-1.5 font-mono text-sm tracking-tight text-[var(--color-text-primary)] hover:text-[var(--color-accent)] transition-colors"
      aria-label="Home"
    >
      <span class="text-[var(--color-prompt)] font-bold">rjaks:~$</span>
      <span class="text-[var(--color-text-primary)] group-hover:text-[var(--color-accent)] font-semibold">cd ~</span>
      <span class="terminal-cursor"></span>
    </a>

    <!-- Directory Navigation -->
    <nav class="space-y-1" aria-label="Sidebar Navigation">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class={`flex items-center justify-between px-2.5 py-1.5 rounded-sm transition-colors group ${item.active ? 'text-[var(--color-accent)] font-bold bg-[var(--color-border-subtle)]' : 'text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:bg-[var(--color-border-subtle)]'}`}
        >
          <span>{item.path}</span>
          {item.key === '@' ? (
            <span class="text-[10px] text-[var(--color-text-muted)]">@</span>
          ) : (
            <kbd class="text-[10px] opacity-75 group-hover:opacity-100">{item.key}</kbd>
          )}
        </a>
      ))}
    </nav>
  </div>

  <!-- Bottom: Controls & Quick Links -->
  <div class="pt-4 border-t border-[var(--color-border-subtle)] space-y-3 text-xs">
    <!-- Mini-game: Wordle Trigger -->
    <button 
      class="open-wordle-trigger w-full flex items-center justify-between px-2.5 py-1.5 rounded-sm border border-[var(--color-border)] hover:border-[var(--color-accent)] text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:bg-[var(--color-border-subtle)] transition-colors group text-[11px] font-mono cursor-pointer"
      title="Play Wordle (Alt+G)"
    >
      <div class="flex items-center gap-1.5">
        <span class="text-[var(--color-prompt)] font-bold">&gt;</span>
        <span>play wordle</span>
      </div>
      <div class="flex items-center gap-0.5">
        <kbd class="text-[9px]">alt</kbd>
        <kbd class="text-[9px]">g</kbd>
      </div>
    </button>

    <div class="flex items-center justify-between gap-2">
      <button 
        class="theme-toggle-btn flex-1 flex items-center justify-between px-2 py-1.5 rounded-sm border border-[var(--color-border)] hover:border-[var(--color-accent)] text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors cursor-pointer text-[11px]"
        aria-label="Toggle dark/light theme"
        title="Toggle Theme (press 't')"
      >
        <div class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 hidden dark-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2"></path>
            <path d="M12 20v2"></path>
            <path d="m4.93 4.93 1.41 1.41"></path>
            <path d="m17.66 17.66 1.41 1.41"></path>
            <path d="M2 12h2"></path>
            <path d="M20 12h2"></path>
            <path d="m6.34 17.66-1.41 1.41"></path>
            <path d="m19.07 4.93-1.41 1.41"></path>
          </svg>
          <svg class="w-3.5 h-3.5 hidden light-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3a6 6 0 0 0 9 9 9 0 1 1-9-9Z"></path>
          </svg>
          <span>theme</span>
        </div>
        <kbd class="text-[10px]">t</kbd>
      </button>

      <button 
        id="sidebar-shortcuts-btn"
        class="flex items-center gap-1 px-2 py-1.5 rounded-sm border border-[var(--color-border)] hover:border-[var(--color-accent)] text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors cursor-pointer text-[11px]"
        aria-label="View keyboard shortcuts"
        title="Open keyboard shortcuts cheat sheet"
      >
        <span>man</span>
        <kbd class="text-[10px]">?</kbd>
      </button>
    </div>

    <div class="pt-2 font-mono space-y-0.5">
      <div class="text-xs text-[var(--color-text-secondary)]">
        get in touch:
      </div>
      <a 
        href="mailto:contact@rjaks.me" 
        class="text-sm font-bold text-[var(--color-accent)] hover:underline block truncate"
      >
        contact@rjaks.me
      </a>
    </div>
  </div>
</aside>

<script>
  function setupNavbar() {
    // Shortcuts button -> modal in KeyboardShortcuts.astro
    const openShortcuts = () => {
      const modal = document.getElementById('shortcuts-modal') as HTMLDialogElement | null;
      modal?.showModal();
    };

    const shortcutsBtn = document.getElementById('sidebar-shortcuts-btn');
    if (shortcutsBtn) shortcutsBtn.onclick = openShortcuts;

    const mobileShortcutsBtn = document.getElementById('mobile-shortcuts-btn');
    if (mobileShortcutsBtn) {
      mobileShortcutsBtn.onclick = () => {
        closeMobileMenu();
        openShortcuts();
      };
    }

    document.querySelectorAll('.open-shortcuts-trigger').forEach((btn) => {
      (btn as HTMLElement).onclick = openShortcuts;
    });

    // Mobile menu drawer toggle
    const menuToggle = document.getElementById('mobile-menu-toggle');
    const menuDrawer = document.getElementById('mobile-menu-drawer');
    const menuLabel = document.getElementById('mobile-menu-label');
    const menuIndicator = menuToggle?.querySelector('.mobile-menu-indicator');

    function closeMobileMenu() {
      if (!menuDrawer || menuDrawer.classList.contains('hidden')) return;
      menuDrawer.classList.add('hidden');
      menuToggle?.setAttribute('aria-expanded', 'false');
      if (menuLabel) menuLabel.textContent = 'menu';
      if (menuIndicator) menuIndicator.textContent = '>';
    }

    function toggleMobileMenu() {
      if (!menuDrawer) return;
      const isClosed = menuDrawer.classList.contains('hidden');
      if (isClosed) {
        menuDrawer.classList.remove('hidden');
        menuToggle?.setAttribute('aria-expanded', 'true');
        if (menuLabel) menuLabel.textContent = 'close';
        if (menuIndicator) menuIndicator.textContent = 'x';
      } else {
        closeMobileMenu();
      }
    }

    if (menuToggle && menuDrawer) {
      menuToggle.onclick = (e) => {
        e.stopPropagation();
        toggleMobileMenu();
      };

      // Close mobile drawer when clicking any link inside it
      menuDrawer.querySelectorAll('a').forEach((link) => {
        link.onclick = () => closeMobileMenu();
      });

      // Close on clicking outside header
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        if (target && !target.closest('header')) {
          closeMobileMenu();
        }
      });

      // Close on ESC key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeMobileMenu();
        }
      });
    }

    // Wordle modal triggers
    document.querySelectorAll('.open-wordle-trigger').forEach((btn) => {
      (btn as HTMLElement).onclick = (e) => {
        e.preventDefault();
        closeMobileMenu();
        const wordleModal = document.getElementById('wordle-modal') as HTMLDialogElement | null;
        wordleModal?.showModal();
      };
    });

    // Sync all theme toggle buttons across mobile header, tablet header, and desktop sidebar
    const toggleBtns = document.querySelectorAll<HTMLButtonElement>('.theme-toggle-btn');
    
    function syncThemeIcons() {
      const isLight = document.documentElement.getAttribute('data-theme') === 'light';
      toggleBtns.forEach((btn) => {
        const darkIcon = btn.querySelector('.dark-icon') as HTMLElement | null;
        const lightIcon = btn.querySelector('.light-icon') as HTMLElement | null;
        if (darkIcon && lightIcon) {
          if (isLight) {
            darkIcon.classList.add('hidden');
            lightIcon.classList.remove('hidden');
          } else {
            darkIcon.classList.remove('hidden');
            lightIcon.classList.add('hidden');
          }
        }
      });
    }

    toggleBtns.forEach((btn) => {
      btn.onclick = () => {
        const isLight = document.documentElement.getAttribute('data-theme') === 'light';
        const newTheme = isLight ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);
        syncThemeIcons();
      };
    });

    syncThemeIcons();

    // Observe theme attribute mutations (e.g. from 't' keyboard shortcut)
    const observer = new MutationObserver((mutations) => {
      for (const m of mutations) {
        if (m.type === 'attributes' && m.attributeName === 'data-theme') {
          syncThemeIcons();
        }
      }
    });

    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme']
    });
  }

  setupNavbar();
  document.addEventListener('astro:page-load', setupNavbar);
</script>

