---
// src/components/GithubHeatmap.astro
import { buildHeatmapSvg, type ContributionDay } from '../utils/heatmap';

let totalContributions = 254;
let days: ContributionDay[] = [];

// In-memory cache during dev server runs to avoid 10-in-10sec rate limits
const globalCache = (globalThis as any).__gh_contributions_cache;
if (globalCache && Date.now() - globalCache.time < 3600000) {
  totalContributions = globalCache.total;
  days = globalCache.days;
} else {
  try {
    const response = await fetch('https://github-contributions-api.jogruber.de/v4/rjaks?y=last');
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    const data = await response.json();
    totalContributions = data.total?.lastYear ?? 254;
    days = data.contributions ?? [];
    (globalThis as any).__gh_contributions_cache = {
      total: totalContributions,
      days,
      time: Date.now(),
    };
  } catch (err) {
    // Fallback placeholder if network is unavailable during build
    const today = new Date();
    for (let i = 364; i >= 0; i--) {
      const d = new Date(today);
      d.setDate(d.getDate() - i);
      days.push({
        date: d.toISOString().split('T')[0],
        count: 0,
        level: 0,
      });
    }
  }
}

const { width, height, html } = buildHeatmapSvg(days);
const lastDate = days[days.length - 1]?.date ?? '';
---

<section class="my-8 sm:my-12">
  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-2">
    <div class="flex items-center gap-2">
      <span class="font-mono text-xs text-[var(--color-prompt)] font-bold">git:~$</span>
      <h2 class="font-heading text-base sm:text-lg font-extrabold tracking-tight text-[var(--color-text-primary)]">
        Contributions
      </h2>
    </div>
    <a 
      href="https://github.com/rjaks" 
      target="_blank" 
      rel="noopener noreferrer"
      class="font-mono text-xs text-[var(--color-accent)] hover:underline flex items-center gap-1"
    >
      <span id="heatmap-count-badge">[{totalContributions} this year]</span>
      <span class="ext-arrow">↗</span>
    </a>
  </div>

  <p class="font-sans text-xs text-[var(--color-text-secondary)] mb-4 italic">
    am i really a dev if i don't put up my github contribution chart?
  </p>

  <!-- Heatmap Container (100% responsive, never scrollable) -->
  <div id="heatmap-container" class="terminal-panel p-3 sm:p-4 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-md w-full relative">
    <div class="w-full">
      <svg 
        id="heatmap-svg"
        viewBox={`0 0 ${width} ${height}`} 
        class="w-full h-auto block select-none" 
        role="img" 
        aria-label={`GitHub contribution calendar: ${totalContributions} contributions in the last year`}
        data-total={totalContributions}
        data-last-date={lastDate}
        set:html={html}
      />
    </div>

    <!-- Terminal Status Bar & Legend -->
    <div class="mt-3 pt-2.5 border-t border-[var(--color-border-subtle)] flex flex-wrap items-center justify-between gap-2 font-mono text-[11px] text-[var(--color-text-secondary)]">
      <div id="heatmap-status" class="flex items-center gap-1.5 min-h-[1.25rem]">
        <span class="text-[var(--color-prompt)] font-bold">&gt;</span>
        <span id="heatmap-status-text" data-default={`${totalContributions} contributions in the last year`}>{totalContributions} contributions in the last year</span>
      </div>

      <div class="flex items-center gap-1.5 ml-auto">
        <span>Less</span>
        <div class="flex items-center gap-1">
          <span class="w-2.5 h-2.5 rounded-[2px] contribution-cell level-0"></span>
          <span class="w-2.5 h-2.5 rounded-[2px] contribution-cell level-1"></span>
          <span class="w-2.5 h-2.5 rounded-[2px] contribution-cell level-2"></span>
          <span class="w-2.5 h-2.5 rounded-[2px] contribution-cell level-3"></span>
          <span class="w-2.5 h-2.5 rounded-[2px] contribution-cell level-4"></span>
        </div>
        <span>More</span>
      </div>
    </div>
  </div>
</section>

<script>
  import { buildHeatmapSvg, type ContributionDay } from '../utils/heatmap';

  function bindTooltips() {
    const container = document.getElementById('heatmap-container');
    const statusText = document.getElementById('heatmap-status-text');
    if (!container || !statusText) return;

    const statusEl = statusText;
    const cells = container.querySelectorAll<SVGRectElement>('rect.contribution-cell');

    function formatDate(dateStr: string) {
      if (!dateStr) return '';
      const [y, m, d] = dateStr.split('-').map(Number);
      return new Date(Date.UTC(y, m - 1, d)).toLocaleDateString('en-US', {
        timeZone: 'UTC',
        weekday: 'short',
        month: 'short',
        day: 'numeric',
        year: 'numeric',
      });
    }

    cells.forEach((cell) => {
      function show() {
        const count = cell.getAttribute('data-count') ?? '0';
        const dateStr = cell.getAttribute('data-date') ?? '';
        const countLabel = count === '1' ? '1 contribution' : `${count} contributions`;
        statusEl.innerHTML = `<span class="text-[var(--color-accent)] font-semibold">${countLabel}</span> on ${formatDate(dateStr)}`;
      }

      function hide() {
        statusEl.textContent = statusEl.getAttribute('data-default') || '';
      }

      cell.addEventListener('mouseenter', show);
      cell.addEventListener('mouseleave', hide);
      cell.addEventListener('focus', show);
      cell.addEventListener('blur', hide);
    });
  }

  async function syncHeatmap() {
    bindTooltips();

    const svg = document.getElementById('heatmap-svg') as SVGSVGElement | null;
    const countBadge = document.getElementById('heatmap-count-badge');
    const statusText = document.getElementById('heatmap-status-text');
    if (!svg) return;

    const cacheKey = 'gh_contribs_v1';
    let cached: { total: number; days: ContributionDay[]; time: number } | null = null;
    try {
      const raw = localStorage.getItem(cacheKey);
      if (raw) cached = JSON.parse(raw);
    } catch {}

    const isFresh = cached && Date.now() - cached.time < 3600000;

    function applyData(total: number, days: ContributionDay[]) {
      if (!days || days.length === 0) return;
      const lastDate = days[days.length - 1]?.date;
      if (svg && (svg.getAttribute('data-last-date') !== lastDate || svg.getAttribute('data-total') !== String(total))) {
        const { width, height, html } = buildHeatmapSvg(days);
        svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
        svg.setAttribute('data-total', String(total));
        svg.setAttribute('data-last-date', lastDate);
        svg.innerHTML = html;
        if (countBadge) countBadge.textContent = `[${total} this year]`;
        if (statusText) {
          const txt = `${total} contributions in the last year`;
          statusText.textContent = txt;
          statusText.setAttribute('data-default', txt);
        }
        bindTooltips();
      }
    }

    if (cached?.days?.length) {
      applyData(cached.total, cached.days);
    }

    if (!isFresh) {
      try {
        const res = await fetch('https://github-contributions-api.jogruber.de/v4/rjaks?y=last');
        if (res.ok) {
          const data = await res.json();
          const total = data.total?.lastYear ?? 0;
          const days: ContributionDay[] = data.contributions ?? [];
          if (days.length > 0) {
            localStorage.setItem(cacheKey, JSON.stringify({ total, days, time: Date.now() }));
            applyData(total, days);
          }
        }
      } catch {}
    }
  }

  syncHeatmap();
  document.addEventListener('astro:page-load', syncHeatmap);
</script>

<style is:global>
  #heatmap-container .contribution-cell {
    transition: filter 0.15s ease, stroke 0.15s ease;
    outline: none;
  }

  #heatmap-container rect.contribution-cell {
    cursor: pointer;
  }

  #heatmap-container rect.contribution-cell:hover,
  #heatmap-container rect.contribution-cell:focus {
    stroke: var(--color-accent);
    stroke-width: 1.5px;
    filter: brightness(1.25);
  }

  #heatmap-container .contribution-cell.level-0 {
    fill: var(--color-border-subtle);
    background-color: var(--color-border-subtle);
  }
  #heatmap-container .contribution-cell.level-1 {
    fill: #78350f;
    background-color: #78350f;
  }
  #heatmap-container .contribution-cell.level-2 {
    fill: #b45309;
    background-color: #b45309;
  }
  #heatmap-container .contribution-cell.level-3 {
    fill: #d97706;
    background-color: #d97706;
  }
  #heatmap-container .contribution-cell.level-4 {
    fill: #f59e0b;
    background-color: #f59e0b;
  }

  [data-theme="light"] #heatmap-container .contribution-cell.level-0 {
    fill: #ebedf0;
    background-color: #ebedf0;
  }
  [data-theme="light"] #heatmap-container .contribution-cell.level-1 {
    fill: #fef3c7;
    background-color: #fef3c7;
  }
  [data-theme="light"] #heatmap-container .contribution-cell.level-2 {
    fill: #fde68a;
    background-color: #fde68a;
  }
  [data-theme="light"] #heatmap-container .contribution-cell.level-3 {
    fill: #f59e0b;
    background-color: #f59e0b;
  }
  [data-theme="light"] #heatmap-container .contribution-cell.level-4 {
    fill: #b45309;
    background-color: #b45309;
  }
</style>
