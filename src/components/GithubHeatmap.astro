---
// src/components/GithubHeatmap.astro
interface ContributionDay {
  date: string;
  count: number;
  level: number;
}

let totalContributions = 254;
let days: ContributionDay[] = [];

try {
  const response = await fetch('https://github-contributions-api.jogruber.de/v4/rjaks?y=last');
  if (response.ok) {
    const data = await response.json();
    totalContributions = data.total?.lastYear ?? 254;
    days = data.contributions ?? [];
  }
} catch (err) {
  // Fallback placeholder if network is unavailable during build
  const today = new Date();
  for (let i = 364; i >= 0; i--) {
    const d = new Date(today);
    d.setDate(d.getDate() - i);
    days.push({
      date: d.toISOString().split('T')[0],
      count: 0,
      level: 0
    });
  }
}

// Group into 7-day calendar columns (Sunday to Saturday)
const weeks: (ContributionDay | null)[][] = [];
let currentWeek: (ContributionDay | null)[] = [];

days.forEach((day) => {
  const [y, m, d] = day.date.split('-').map(Number);
  const date = new Date(Date.UTC(y, m - 1, d));
  const dayOfWeek = date.getUTCDay(); // 0 is Sunday, 6 is Saturday

  if (dayOfWeek === 0 && currentWeek.length > 0) {
    while (currentWeek.length < 7) {
      currentWeek.push(null);
    }
    weeks.push(currentWeek);
    currentWeek = [];
  }

  if (weeks.length === 0 && currentWeek.length === 0) {
    for (let i = 0; i < dayOfWeek; i++) {
      currentWeek.push(null);
    }
  }

  currentWeek.push(day);
});

if (currentWeek.length > 0) {
  while (currentWeek.length < 7) {
    currentWeek.push(null);
  }
  weeks.push(currentWeek);
}

// Calculate month labels positioned along the week columns
interface MonthLabel {
  name: string;
  x: number;
}

const months: MonthLabel[] = [];
let lastMonth = -1;
const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

weeks.forEach((week, weekIndex) => {
  const firstValidDay = week.find((d) => d !== null);
  if (firstValidDay) {
    const [, m] = firstValidDay.date.split('-').map(Number);
    const monthIndex = m - 1;
    if (monthIndex !== lastMonth) {
      // Avoid placing month label right on the last 2 weeks to avoid clipping
      if (weekIndex <= weeks.length - 2 || weekIndex === 0) {
        months.push({
          name: monthNames[monthIndex],
          x: weekIndex * 13 + 2,
        });
      }
      lastMonth = monthIndex;
    }
  }
});

const cellStep = 13;
const svgWidth = Math.max(weeks.length * cellStep - 3 + 4, 690);
const svgHeight = 110;
---

<section class="my-8 sm:my-12">
  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-2">
    <div class="flex items-center gap-2">
      <span class="font-mono text-xs text-[var(--color-prompt)] font-bold">git:~$</span>
      <h2 class="font-heading text-base sm:text-lg font-extrabold tracking-tight text-[var(--color-text-primary)]">
        Contributions
      </h2>
    </div>
    <a 
      href="https://github.com/rjaks" 
      target="_blank" 
      rel="noopener noreferrer"
      class="font-mono text-xs text-[var(--color-accent)] hover:underline flex items-center gap-1"
    >
      <span>[{totalContributions} this year]</span>
      <span class="ext-arrow">↗</span>
    </a>
  </div>

  <p class="font-sans text-xs text-[var(--color-text-secondary)] mb-4 italic">
    am i really a dev if i don't put up my github contribution chart?
  </p>

  <!-- Heatmap Container (100% responsive, never scrollable) -->
  <div id="heatmap-container" class="terminal-panel p-3 sm:p-4 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-md w-full relative">
    <div class="w-full">
      <svg 
        viewBox={`0 0 ${svgWidth} ${svgHeight}`} 
        class="w-full h-auto block select-none" 
        role="img" 
        aria-label={`GitHub contribution calendar: ${totalContributions} contributions in the last year`}
      >
        <!-- Month Labels -->
        {months.map((m) => (
          <text 
            x={m.x} 
            y="12" 
            class="month-label font-mono text-[9px] fill-[var(--color-text-secondary)]"
          >
            {m.name}
          </text>
        ))}

        <!-- Contribution Grid (53 weeks x 7 days) -->
        {weeks.map((week, colIndex) => (
          <g transform={`translate(${colIndex * cellStep + 2}, 20)`}>
            {week.map((day, rowIndex) => {
              if (!day) return null;
              return (
                <rect
                  class={`contribution-cell level-${day.level}`}
                  x="0"
                  y={rowIndex * cellStep}
                  width="10"
                  height="10"
                  rx="2"
                  data-date={day.date}
                  data-count={day.count}
                  tabindex="0"
                >
                  <title>{day.count === 0 ? 'No' : day.count} contribution{day.count === 1 ? '' : 's'} on {day.date}</title>
                </rect>
              );
            })}
          </g>
        ))}
      </svg>
    </div>

    <!-- Terminal Status Bar & Legend -->
    <div class="mt-3 pt-2.5 border-t border-[var(--color-border-subtle)] flex flex-wrap items-center justify-between gap-2 font-mono text-[11px] text-[var(--color-text-secondary)]">
      <div id="heatmap-status" class="flex items-center gap-1.5 min-h-[1.25rem]">
        <span class="text-[var(--color-prompt)] font-bold">&gt;</span>
        <span id="heatmap-status-text">{totalContributions} contributions in the last year</span>
      </div>

      <div class="flex items-center gap-1.5 ml-auto">
        <span>Less</span>
        <div class="flex items-center gap-1">
          <span class="w-2.5 h-2.5 rounded-[2px] contribution-cell level-0"></span>
          <span class="w-2.5 h-2.5 rounded-[2px] contribution-cell level-1"></span>
          <span class="w-2.5 h-2.5 rounded-[2px] contribution-cell level-2"></span>
          <span class="w-2.5 h-2.5 rounded-[2px] contribution-cell level-3"></span>
          <span class="w-2.5 h-2.5 rounded-[2px] contribution-cell level-4"></span>
        </div>
        <span>More</span>
      </div>
    </div>
  </div>

  <!-- Floating Custom Tooltip -->
  <div 
    id="heatmap-tooltip" 
    class="pointer-events-none fixed z-50 hidden px-2.5 py-1 text-[11px] font-mono rounded bg-[var(--color-surface)] border border-[var(--color-accent)] text-[var(--color-text-primary)] shadow-lg"
    role="tooltip"
  >
  </div>
</section>

<script>
  function setupHeatmap() {
    const container = document.getElementById('heatmap-container');
    const tooltip = document.getElementById('heatmap-tooltip');
    const statusText = document.getElementById('heatmap-status-text');
    if (!container || !tooltip || !statusText) return;

    const defaultText = statusText.textContent || '';
    const cells = container.querySelectorAll<SVGRectElement>('.contribution-cell');

    function formatDate(dateStr: string) {
      if (!dateStr) return '';
      const [y, m, d] = dateStr.split('-').map(Number);
      const date = new Date(Date.UTC(y, m - 1, d));
      return date.toLocaleDateString('en-US', {
        timeZone: 'UTC',
        weekday: 'short',
        month: 'short',
        day: 'numeric',
        year: 'numeric',
      });
    }

    function positionTooltip(e: MouseEvent) {
      const tooltipWidth = tooltip?.offsetWidth || 150;
      const x = e.clientX + 12 + tooltipWidth > window.innerWidth
        ? e.clientX - tooltipWidth - 10
        : e.clientX + 12;
      const y = e.clientY - 42 < 10
        ? e.clientY + 18
        : e.clientY - 42;
      if (tooltip) {
        tooltip.style.left = `${x}px`;
        tooltip.style.top = `${y}px`;
      }
    }

    cells.forEach((cell) => {
      function show(e: MouseEvent | FocusEvent) {
        const count = cell.getAttribute('data-count') ?? '0';
        const dateStr = cell.getAttribute('data-date') ?? '';
        const formatted = formatDate(dateStr);
        const countLabel = count === '1' ? '1 contribution' : `${count} contributions`;

        if (statusText) {
          statusText.innerHTML = `<span class="text-[var(--color-accent)] font-semibold">${countLabel}</span> on ${formatted}`;
        }

        if (tooltip && 'clientX' in e && e.clientX > 0) {
          tooltip.innerHTML = `<div><strong>${countLabel}</strong></div><div class="text-[var(--color-text-secondary)] text-[10px]">${formatted}</div>`;
          tooltip.classList.remove('hidden');
          positionTooltip(e);
        }
      }

      function hide() {
        if (statusText) {
          statusText.textContent = defaultText;
        }
        if (tooltip) {
          tooltip.classList.add('hidden');
        }
      }

      cell.addEventListener('mouseenter', show);
      cell.addEventListener('mousemove', (e) => positionTooltip(e));
      cell.addEventListener('mouseleave', hide);
      cell.addEventListener('focus', show);
      cell.addEventListener('blur', hide);
    });
  }

  setupHeatmap();
  document.addEventListener('astro:page-load', setupHeatmap);
</script>

<style>
  .contribution-cell {
    transition: filter 0.15s ease, stroke 0.15s ease;
    outline: none;
  }

  rect.contribution-cell {
    cursor: pointer;
  }

  rect.contribution-cell:hover,
  rect.contribution-cell:focus {
    stroke: var(--color-accent);
    stroke-width: 1.5px;
    filter: brightness(1.25);
  }

  .contribution-cell.level-0 {
    fill: var(--color-border-subtle);
    background-color: var(--color-border-subtle);
  }
  .contribution-cell.level-1 {
    fill: #0e4429;
    background-color: #0e4429;
  }
  .contribution-cell.level-2 {
    fill: #006d32;
    background-color: #006d32;
  }
  .contribution-cell.level-3 {
    fill: #26a641;
    background-color: #26a641;
  }
  .contribution-cell.level-4 {
    fill: #39d353;
    background-color: #39d353;
  }

  [data-theme="light"] .contribution-cell.level-0 {
    fill: #ebedf0;
    background-color: #ebedf0;
  }
  [data-theme="light"] .contribution-cell.level-1 {
    fill: #9be9a8;
    background-color: #9be9a8;
  }
  [data-theme="light"] .contribution-cell.level-2 {
    fill: #40c463;
    background-color: #40c463;
  }
  [data-theme="light"] .contribution-cell.level-3 {
    fill: #30a14e;
    background-color: #30a14e;
  }
  [data-theme="light"] .contribution-cell.level-4 {
    fill: #216e39;
    background-color: #216e39;
  }
</style>
