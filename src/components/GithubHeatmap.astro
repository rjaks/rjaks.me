---
// src/components/GithubHeatmap.astro
interface ContributionDay {
  date: string;
  count: number;
  level: number;
}

let totalContributions = 254;
let days: ContributionDay[] = [];

try {
  const response = await fetch('https://github-contributions-api.jogruber.de/v4/rjaks?y=last');
  if (response.ok) {
    const data = await response.json();
    totalContributions = data.total?.lastYear ?? 254;
    days = data.contributions ?? [];
  }
} catch (err) {
  // Fallback placeholder if network is unavailable during build
  const today = new Date();
  for (let i = 364; i >= 0; i--) {
    const d = new Date(today);
    d.setDate(d.getDate() - i);
    days.push({
      date: d.toISOString().split('T')[0],
      count: 0,
      level: 0
    });
  }
}

// Group into 7-day columns (weeks)
const weeks: ContributionDay[][] = [];
let currentWeek: ContributionDay[] = [];

days.forEach((day) => {
  currentWeek.push(day);
  if (currentWeek.length === 7) {
    weeks.push(currentWeek);
    currentWeek = [];
  }
});
if (currentWeek.length > 0) {
  weeks.push(currentWeek);
}
---

<section class="my-8 sm:my-12">
  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-2">
    <div class="flex items-center gap-2">
      <span class="font-mono text-xs text-[var(--color-prompt)] font-bold">git:~$</span>
      <h2 class="font-heading text-base sm:text-lg font-extrabold tracking-tight text-[var(--color-text-primary)]">
        Contributions
      </h2>
    </div>
    <a 
      href="https://github.com/rjaks" 
      target="_blank" 
      rel="noopener noreferrer"
      class="font-mono text-xs text-[var(--color-accent)] hover:underline flex items-center gap-1"
    >
      <span>[{totalContributions} this year]</span>
      <span class="ext-arrow">↗</span>
    </a>
  </div>

  <p class="font-sans text-xs text-[var(--color-text-secondary)] mb-4 italic">
    am i really a dev if i don't put up my github contribution chart?
  </p>

  <!-- Heatmap Scrollable Container -->
  <div class="terminal-panel p-3 sm:p-4 overflow-x-auto bg-[var(--color-surface)] border border-[var(--color-border)] rounded-md">
    <div class="inline-flex gap-1 min-w-full pb-1" role="img" aria-label={`GitHub contribution calendar: ${totalContributions} contributions in the last year`}>
      {weeks.map((week) => (
        <div class="flex flex-col gap-1">
          {week.map((day) => (
            <div
              class={`w-2.5 h-2.5 rounded-[2px] transition-transform hover:scale-125 cursor-pointer contribution-cell level-${day.level}`}
              data-date={day.date}
              data-count={day.count}
              title={`${day.count} contribution${day.count === 1 ? '' : 's'} on ${day.date}`}
            />
          ))}
        </div>
      ))}
    </div>

    <div class="mt-3 pt-2 border-t border-[var(--color-border-subtle)] flex items-center justify-between font-mono text-[11px] text-[var(--color-text-secondary)]">
      <span>Less</span>
      <div class="flex items-center gap-1">
        <span class="w-2.5 h-2.5 rounded-[2px] contribution-cell level-0"></span>
        <span class="w-2.5 h-2.5 rounded-[2px] contribution-cell level-1"></span>
        <span class="w-2.5 h-2.5 rounded-[2px] contribution-cell level-2"></span>
        <span class="w-2.5 h-2.5 rounded-[2px] contribution-cell level-3"></span>
        <span class="w-2.5 h-2.5 rounded-[2px] contribution-cell level-4"></span>
      </div>
      <span>More</span>
    </div>
  </div>
</section>

<style>
  .contribution-cell.level-0 {
    background-color: var(--color-border-subtle);
  }
  .contribution-cell.level-1 {
    background-color: #0e4429;
  }
  .contribution-cell.level-2 {
    background-color: #006d32;
  }
  .contribution-cell.level-3 {
    background-color: #26a641;
  }
  .contribution-cell.level-4 {
    background-color: #39d353;
  }

  [data-theme="light"] .contribution-cell.level-0 {
    background-color: #ebedf0;
  }
  [data-theme="light"] .contribution-cell.level-1 {
    background-color: #9be9a8;
  }
  [data-theme="light"] .contribution-cell.level-2 {
    background-color: #40c463;
  }
  [data-theme="light"] .contribution-cell.level-3 {
    background-color: #30a14e;
  }
  [data-theme="light"] .contribution-cell.level-4 {
    background-color: #216e39;
  }
</style>
