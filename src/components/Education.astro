---
---

<section id="education" class="education-section">
  <div class="container-custom">
    <div class="section-header">
      <h2 class="section-title">Education</h2>
      <p class="section-subtitle">Academic background and continuous learning journey.</p>
    </div>

    <div class="education-grid">
      <!-- Card 1 -->
      <div class="education-card">
        <span class="edu-year">2023 — 2027</span>
        <h3 class="edu-institution">Ateneo de Naga University</h3>
        <p class="edu-degree">BS Computer Science</p>
        <span class="edu-honor">Cum Laude Candidate</span>
      </div>

      <!-- Card 2 -->
      <div class="education-card">
        <span class="edu-year">2017 — 2023</span>
        <h3 class="edu-institution">Camarines Sur National High School</h3>
        <p class="edu-degree">TVL — Programming</p>
        <span class="edu-honor">With High Honors</span>
      </div>

      <!-- Card 3 -->
      <div class="education-card">
        <span class="edu-year">2011 — 2017</span>
        <h3 class="edu-institution">Minds That Matter School</h3>
        <p class="edu-degree">Elementary Education</p>
        <span class="edu-honor">Most Outstanding Student</span>
      </div>
    </div>
  </div>
</section>

<style>
  .education-section {
    padding: var(--space-4xl) 0;
    background-color: var(--color-bg);
  }

  .section-header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto var(--space-3xl) auto;
  }

  .section-title {
    font-family: var(--font-family-heading);
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-normal);
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
  }

  .section-subtitle {
    font-family: var(--font-family-base);
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    margin-top: var(--space-xs);
    line-height: 1.5;
  }

  .education-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
    max-width: 950px;
    margin: 0 auto;
  }

  .education-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-xl);
    box-shadow: var(--shadow-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    transition: transform var(--transition-normal), background-color var(--transition-normal), box-shadow var(--transition-normal);
  }

  .education-card:hover {
    background-color: var(--color-surface-hover);
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
  }

  .edu-year {
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    letter-spacing: -0.03em;
    color: var(--color-accent);
    text-transform: uppercase;
  }

  .edu-institution {
    font-family: var(--font-family-heading);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-normal);
    color: var(--color-text-primary);
    margin-top: var(--space-2xs);
  }

  .edu-degree {
    font-family: var(--font-family-base);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }

  .edu-honor {
    margin-top: auto;
    padding-top: var(--space-md);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-xs);
    color: var(--color-accent-secondary);
  }

  @media (max-width: 860px) {
    .education-grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }
</style>
