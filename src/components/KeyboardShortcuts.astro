---
// src/components/KeyboardShortcuts.astro
---

<!-- Keyboard Shortcuts Modal / Cheat Sheet -->
<dialog id="shortcuts-modal" class="fixed inset-0 m-auto z-50 p-2 sm:p-4 bg-transparent border-none text-inherit backdrop:bg-black/75 backdrop:backdrop-blur-sm open:flex items-center justify-center w-full h-full max-w-none max-h-none">
  <div class="terminal-panel w-[calc(100%-1.5rem)] sm:w-full max-w-md bg-[var(--color-surface)] border border-[var(--color-border)] shadow-2xl p-4 sm:p-6 relative text-[var(--color-text-primary)]">
    <div class="flex items-center justify-between pb-3 border-b border-[var(--color-border)]">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-[var(--color-accent)] animate-pulse"></span>
        <h3 id="modal-title" class="text-sm sm:text-base font-mono font-bold text-[var(--color-text-primary)]">
          rjaks:~$ man shortcuts
        </h3>
      </div>
      <form method="dialog">
        <button class="text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] font-mono text-xs cursor-pointer px-2 py-1 border border-[var(--color-border)] rounded-xs hover:border-[var(--color-accent)] transition-colors">
          ESC [x]
        </button>
      </form>
    </div>

    <div class="mt-4 space-y-3 font-mono text-xs sm:text-sm">
      <p class="text-[var(--color-text-secondary)] text-xs mb-3">
        Navigate through the site with single keypresses:
      </p>

      <div class="grid grid-cols-2 gap-2 text-xs">
        <div class="flex items-center justify-between p-2 rounded-xs bg-[var(--color-bg)] border border-[var(--color-border-subtle)]">
          <span class="text-[var(--color-text-secondary)]">Home</span>
          <kbd>h</kbd>
        </div>
        <div class="flex items-center justify-between p-2 rounded-xs bg-[var(--color-bg)] border border-[var(--color-border-subtle)]">
          <span class="text-[var(--color-text-secondary)]">Work</span>
          <kbd>w</kbd>
        </div>
        <div class="flex items-center justify-between p-2 rounded-xs bg-[var(--color-bg)] border border-[var(--color-border-subtle)]">
          <span class="text-[var(--color-text-secondary)]">Projects</span>
          <kbd>p</kbd>
        </div>
        <div class="flex items-center justify-between p-2 rounded-xs bg-[var(--color-bg)] border border-[var(--color-border-subtle)]">
          <span class="text-[var(--color-text-secondary)]">Writing</span>
          <kbd>b</kbd>
        </div>
        <div class="flex items-center justify-between p-2 rounded-xs bg-[var(--color-bg)] border border-[var(--color-border-subtle)]">
          <span class="text-[var(--color-text-secondary)]">Skills</span>
          <kbd>s</kbd>
        </div>
        <div class="flex items-center justify-between p-2 rounded-xs bg-[var(--color-bg)] border border-[var(--color-border-subtle)]">
          <span class="text-[var(--color-text-secondary)]">Toggle Theme</span>
          <kbd>t</kbd>
        </div>
        <div class="flex items-center justify-between p-2 rounded-xs bg-[var(--color-bg)] border border-[var(--color-border-subtle)]">
          <span class="text-[var(--color-text-secondary)]">Play Wordle</span>
          <div class="flex items-center gap-0.5">
            <kbd>alt</kbd>
            <kbd>g</kbd>
          </div>
        </div>
        <div class="flex items-center justify-between p-2 rounded-xs bg-[var(--color-bg)] border border-[var(--color-border-subtle)]">
          <span class="text-[var(--color-text-secondary)]">Help</span>
          <kbd>?</kbd>
        </div>
      </div>
    </div>

    <div class="mt-5 pt-3 border-t border-[var(--color-border)] flex items-center justify-between text-[11px] text-[var(--color-text-secondary)] font-mono">
      <span>Tip: Press ESC or click outside to dismiss</span>
      <span class="text-[var(--color-accent)]">● live</span>
    </div>
  </div>
</dialog>

<!-- Floating Terminal Key Action Toast -->
<div id="terminal-toast" class="fixed bottom-6 right-6 z-40 hidden pointer-events-none transition-all duration-200 opacity-0 translate-y-2">
  <div class="flex items-center gap-2 px-3 py-1.5 rounded-sm bg-[var(--color-surface)] border border-[var(--color-accent)] text-[var(--color-accent)] font-mono text-xs shadow-lg">
    <span class="text-[var(--color-prompt)] font-bold">&gt;</span>
    <span id="toast-message"></span>
  </div>
</div>

<script>
  import { navigate } from 'astro:transitions/client';

  let toastTimeout: number;

  function showToast(text: string) {
    const toast = document.getElementById('terminal-toast');
    const toastMsg = document.getElementById('toast-message');
    if (!toast || !toastMsg) return;
    toastMsg.textContent = text;
    toast.classList.remove('hidden');
    requestAnimationFrame(() => {
      toast.classList.remove('opacity-0', 'translate-y-2');
      toast.classList.add('opacity-100', 'translate-y-0');
    });

    window.clearTimeout(toastTimeout);
    toastTimeout = window.setTimeout(() => {
      toast.classList.remove('opacity-100', 'translate-y-0');
      toast.classList.add('opacity-0', 'translate-y-2');
      setTimeout(() => toast.classList.add('hidden'), 200);
    }, 1200);
  }

  function setupShortcuts() {
    const modal = document.getElementById('shortcuts-modal') as HTMLDialogElement | null;

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });

    // Auto-open Wordle modal if URL has #wordle hash
    function checkWordleHash() {
      if (window.location.hash === '#wordle') {
        const wordleModal = document.getElementById('wordle-modal') as HTMLDialogElement | null;
        wordleModal?.showModal();
      }
    }

    checkWordleHash();

    // Ensure global window listeners are bound only once
    if ((window as any).__shortcuts_bound) return;
    (window as any).__shortcuts_bound = true;

    const routes: Record<string, [string, string]> = {
      h: ['/', 'cd ~ (home)'],
      w: ['/work', 'cd ~/work'],
      p: ['/projects', 'cd ~/projects'],
      b: ['/writing', 'cd ~/writing'],
      s: ['/skills', 'cd ~/skills'],
    };

    window.addEventListener('hashchange', checkWordleHash);

    window.addEventListener('keydown', (e: KeyboardEvent) => {
      const target = e.target as HTMLElement;
      if (
        target &&
        (target.tagName === 'INPUT' ||
         target.tagName === 'TEXTAREA' ||
         target.tagName === 'SELECT' ||
         target.isContentEditable)
      ) {
        return;
      }

      // Alt + G: Play Wordle Modal
      if (e.altKey && e.key.toLowerCase() === 'g') {
        e.preventDefault();
        showToast('> play wordle');
        const wordleModal = document.getElementById('wordle-modal') as HTMLDialogElement | null;
        if (wordleModal) {
          if (wordleModal.open) {
            wordleModal.close();
          } else {
            wordleModal.showModal();
          }
        }
        return;
      }

      // If Wordle modal is currently open, do not intercept keys for site navigation
      const wordleModal = document.getElementById('wordle-modal') as HTMLDialogElement | null;
      if (wordleModal?.open) {
        return;
      }

      if (e.ctrlKey || e.metaKey || e.altKey) return;

      const modalEl = document.getElementById('shortcuts-modal') as HTMLDialogElement | null;

      if (e.key === '?' || (e.shiftKey && e.key === '/')) {
        e.preventDefault();
        if (modalEl?.open) {
          modalEl.close();
        } else {
          modalEl?.showModal();
          showToast('man shortcuts');
        }
        return;
      }

      const key = e.key.toLowerCase();
      if (routes[key]) {
        e.preventDefault();
        const [path, label] = routes[key];
        showToast(label);
        navigate(path);
        return;
      }

      if (key === 't') {
        e.preventDefault();
        const currentTheme = document.documentElement.getAttribute('data-theme');
        const newTheme = currentTheme === 'light' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);
        showToast(`theme set to ${newTheme}`);
      }
    });
  }

  setupShortcuts();
  document.addEventListener('astro:page-load', setupShortcuts);
</script>
