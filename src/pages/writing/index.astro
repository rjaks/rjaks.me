---
// src/pages/writing/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout 
  title="Writing — Adrian Reforsado (rjaks)" 
  description="Technical notes, architectural trade-offs, and essays on software engineering by Adrian Reforsado."
>
  <div class="space-y-6">
    <!-- Terminal Prompt Breadcrumb -->
    <div class="flex items-center gap-2 font-mono text-xs text-[var(--color-prompt)] font-bold">
      <span>rjaks:~$</span>
      <span class="text-[var(--color-text-primary)]">ls -la ~/writing</span>
    </div>

    <div>
      <h1 class="font-heading text-2xl sm:text-3xl font-extrabold tracking-tight text-[var(--color-text-primary)]">
        Writing & Notes
      </h1>
      <p class="font-sans text-xs sm:text-sm text-[var(--color-text-secondary)] mt-1.5">
        Reflections, technical deep dives, and notes on software engineering, distributed systems, and craft.
      </p>
    </div>

    <!-- Posts List -->
    <div class="divide-y divide-[var(--color-border-subtle)] border border-[var(--color-border)] rounded-md bg-[var(--color-surface)] mt-8">
      {posts.map((post) => (
        <article class="p-4 sm:p-5 hover:bg-[var(--color-surface-hover)] transition-colors">
          <a href={`/writing/${post.id}`} class="group block space-y-2">
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
              <h2 class="font-heading text-sm sm:text-base font-extrabold text-[var(--color-text-primary)] group-hover:text-[var(--color-accent)] transition-colors">
                {post.data.title}
              </h2>
              <time class="font-mono text-xs text-[var(--color-text-muted)] shrink-0">
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
            </div>

            <p class="font-sans text-xs sm:text-sm text-[var(--color-text-secondary)] leading-relaxed line-clamp-2">
              {post.data.description}
            </p>

            <div class="flex items-center gap-2 pt-1">
              {post.data.tags.map((tag) => (
                <span class="terminal-badge text-[10px]">
                  #{tag}
                </span>
              ))}
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
