---
// src/pages/writing/[...slug].astro
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout 
  title={`${post.data.title} — Adrian Reforsado`} 
  description={post.data.description}
>
  <article class="space-y-6 max-w-3xl">
    <!-- Back to Writing Breadcrumb -->
    <div>
      <a 
        href="/writing" 
        class="font-mono text-xs text-[var(--color-accent)] hover:underline inline-flex items-center gap-1.5 group"
      >
        <span class="text-[var(--color-prompt)] font-bold">&lt;--</span>
        <span>cd ~/writing</span>
      </a>
    </div>

    <!-- Header -->
    <header class="space-y-3 pb-6 border-b border-[var(--color-border)]">
      <div class="flex items-center gap-2 font-mono text-[11px] text-[var(--color-text-muted)]">
        <span>cat</span>
        <span class="text-[var(--color-accent-secondary)]">{post.id}.md</span>
      </div>

      <h1 class="font-heading text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-[var(--color-text-primary)]">
        {post.data.title}
      </h1>

      <div class="flex flex-wrap items-center gap-3 font-mono text-xs text-[var(--color-text-secondary)]">
        <time>
          {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        <span>•</span>
        <div class="flex flex-wrap gap-1.5">
          {post.data.tags.map((tag: string) => (
            <span class="terminal-badge text-[10px]">
              #{tag}
            </span>
          ))}
        </div>
      </div>
    </header>

    <!-- Post Body -->
    <div class="prose-terminal font-sans text-sm sm:text-base leading-relaxed text-[var(--color-text-primary)] space-y-4">
      <Content />
    </div>

    <!-- Article Footer -->
    <footer class="mt-12 pt-6 border-t border-[var(--color-border)] flex items-center justify-between font-mono text-xs text-[var(--color-text-secondary)]">
      <a href="/writing" class="hover:text-[var(--color-accent)] transition-colors">
        ← Back to Writing
      </a>
      <a href="#top" class="hover:text-[var(--color-accent)] transition-colors">
        Back to top ↑
      </a>
    </footer>
  </article>
</BaseLayout>

<style is:global>
  /* Markdown Content Styling */
  .prose-terminal h2 {
    font-family: var(--font-family-heading);
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.05em;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--color-text-primary);
  }

  .prose-terminal h3 {
    font-family: var(--font-family-heading);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--color-text-primary);
  }

  .prose-terminal p {
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  .prose-terminal p strong {
    color: var(--color-text-primary);
    font-weight: 700;
  }

  .prose-terminal ul, .prose-terminal ol {
    margin-left: 1.5rem;
    margin-bottom: 1.25rem;
    color: var(--color-text-secondary);
  }

  .prose-terminal ul {
    list-style-type: disc;
  }

  .prose-terminal ol {
    list-style-type: decimal;
  }

  .prose-terminal li {
    margin-bottom: 0.35rem;
  }

  .prose-terminal pre {
    background-color: var(--color-surface) !important;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1rem;
    overflow-x: auto;
    font-family: var(--font-family-mono);
    font-size: 0.825rem;
    margin: 1.5rem 0;
  }

  .prose-terminal code:not(pre code) {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border-subtle);
    padding: 0.15rem 0.35rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-family-mono);
    font-size: 0.85em;
    color: var(--color-accent);
  }

  .prose-terminal blockquote {
    border-left: 2px solid var(--color-accent);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--color-text-secondary);
    font-style: italic;
  }
</style>
