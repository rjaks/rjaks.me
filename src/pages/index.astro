---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import GithubHeatmap from '../components/GithubHeatmap.astro';
import NowSection from '../components/NowSection.astro';
import { projects } from '../data/projects';
import { highlightSkillCategories } from '../data/skills';
import { getCollection } from 'astro:content';

const avatarUrl = '/images/avatar.png';

const featuredProjects = projects.filter((p) => p.featured).slice(0, 3);
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout 
  title="Adrian Reforsado (rjaks) — Software Engineer & Developer" 
  description="Personal website of Adrian Reforsado (rjaks). Software engineer, CS student, building developer tools and clean web systems."
>
  <!-- Hero / Introduction -->
  <section class="space-y-4 reveal-on-scroll stagger-1">
    <!-- Shell Prompt Breadcrumb / Command -->
    <div class="flex items-center gap-2 font-mono text-xs text-[var(--color-prompt)] font-bold">
      <span>rjaks:~$</span>
      <span class="text-[var(--color-text-primary)]">whoami</span>
    </div>

    <div class="flex flex-col sm:flex-row items-start gap-5 sm:gap-8">
      <!-- Avatar with Terminal Frame -->
      <div class="relative shrink-0 group self-center sm:self-start">
        <div class="w-48 h-48 sm:w-44 sm:h-44 md:w-48 md:h-48 rounded-xl overflow-hidden border-2 border-[var(--color-border)] group-hover:border-[var(--color-accent)] transition-all shadow-md group-hover:shadow-[var(--shadow-accent)] bg-[var(--color-surface)]">
          <img 
            src={avatarUrl} 
            alt="Adrian Reforsado (rjaks)" 
            width="192"
            height="192"
            class="w-full h-full object-cover object-[center_15%] grayscale contrast-105 group-hover:grayscale-0 transition-all duration-300"
            loading="eager"
          />
        </div>
        <div class="absolute -bottom-2 -right-2 bg-[var(--color-surface)] border border-[var(--color-border)] group-hover:border-[var(--color-accent)] px-1.5 py-0.5 rounded text-[11px] font-mono text-[var(--color-accent)] shadow-sm">
          ~/rjaks
        </div>
      </div>

      <div class="space-y-3 sm:space-y-4 flex-1 min-w-0">
        <div>
          <h1 class="font-heading text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-[var(--color-text-primary)]">
            Adrian Reforsado
          </h1>
          <p class="font-mono text-xs sm:text-sm text-[var(--color-accent)] mt-1">
            Software Engineer & CS Student
          </p>
        </div>

        <!-- Editorial Narrative (inspired by kavin.me) -->
        <p class="font-sans text-xs sm:text-sm md:text-base leading-relaxed text-[var(--color-text-secondary)] max-w-2xl">
          I'm a Computer Science student and software engineer focused on building robust, high-performance web systems, developer tooling, and thoughtful digital interfaces. I like working with <span class="font-mono text-xs text-[var(--color-text-primary)] font-semibold">TypeScript</span>, <span class="font-mono text-xs text-[var(--color-text-primary)] font-semibold">Nuxt</span>, and <span class="font-mono text-xs text-[var(--color-text-primary)] font-semibold">Cloudflare</span> services. Outside of code, you'll usually find me exploring new music, books, or tweaking terminal environments.
        </p>

        <!-- Social & Contact Links -->
        <SocialLinks />
      </div>
    </div>
  </section>

  <!-- Live GitHub Heatmap -->
  <div class="reveal-on-scroll stagger-2">
    <GithubHeatmap />
  </div>

  <!-- Now & Off The Terminal Section -->
  <div class="reveal-on-scroll stagger-3">
    <NowSection />
  </div>

  <!-- Featured Projects Highlight (Bryllim-style Spotlight Card Deck) -->
  <section class="my-8 sm:my-14 reveal-on-scroll">
    <div class="flex items-center justify-between gap-2 mb-6 sm:mb-8">
      <div class="flex items-center gap-2 min-w-0">
        <span class="font-mono text-xs text-[var(--color-accent)] font-bold shrink-0">~/projects $</span>
        <h2 class="font-heading text-base sm:text-lg font-extrabold tracking-tight text-[var(--color-text-primary)] truncate">
          Selected Projects
        </h2>
      </div>

      <a href="/projects" class="font-mono text-xs text-[var(--color-accent)] hover:underline inline-flex items-center gap-1 shrink-0">
        <span>View all ({projects.length})</span>
        <span class="ext-arrow">→</span>
      </a>
    </div>

    <!-- Mobile Spotlight Deck (< 640px) -->
    <div class="sm:hidden">
      <div class="spotlight-deck" data-deck>
        {featuredProjects.map((project, idx) => {
          const initialSlot = idx === 0 ? 'is-center' : idx === 1 ? 'is-right' : 'is-left';
          return (
            <article 
              class={`deck-card ${initialSlot} terminal-panel bg-[var(--color-surface)] border border-[var(--color-border)] rounded-lg overflow-hidden group select-none flex flex-col`}
              role="button"
              tabindex="0"
              aria-label={`Select project: ${project.title}`}
              data-deck-card
              data-index={idx}
            >
              <!-- Terminal Window Header -->
              <div class="px-3 py-1.5 bg-[var(--color-surface)] border-b border-[var(--color-border-subtle)] flex items-center justify-between font-mono text-[10px] shrink-0">
                <div class="flex items-center gap-1">
                  <span class="w-2 h-2 rounded-full bg-[#EF4444] opacity-75"></span>
                  <span class="w-2 h-2 rounded-full bg-[#F59E0B] opacity-75"></span>
                  <span class="w-2 h-2 rounded-full bg-[#10B981] opacity-75"></span>
                </div>
                <span class="text-[var(--color-text-muted)] text-[9px] truncate max-w-[120px]">
                  ~/projects/{project.title.toLowerCase().replace(/\s+/g, '-')}
                </span>
              </div>

              <!-- Preview Image -->
              {project.image && (
                <div class="relative aspect-[16/9] overflow-hidden bg-[var(--color-bg)] border-b border-[var(--color-border-subtle)] shrink-0">
                  <img 
                    src={project.image} 
                    alt={project.imageAlt || project.title}
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300"
                  />
                </div>
              )}

              <!-- Content -->
              <div class="p-4 pb-6 flex flex-col justify-between flex-1">
                <div>
                  <div class="flex items-start justify-between gap-2 mb-2">
                    <h3 class="font-heading text-xs font-extrabold text-[var(--color-text-primary)] group-hover:text-[var(--color-accent)] transition-colors truncate">
                      {project.title}
                    </h3>
                    <div class="flex items-center gap-1.5 font-mono text-[11px] shrink-0 deck-card-links">
                      {project.github && project.github !== '#' && (
                        <a 
                          href={project.github} 
                          target="_blank" 
                          rel="noopener noreferrer" 
                          class="text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors"
                        >
                          code ↗
                        </a>
                      )}
                      {project.link && project.link !== '#' && (
                        <a 
                          href={project.link} 
                          target="_blank" 
                          rel="noopener noreferrer" 
                          class="text-[var(--color-accent)] hover:underline"
                        >
                          live ↗
                        </a>
                      )}
                    </div>
                  </div>
                  <p class="font-sans text-xs text-[var(--color-text-secondary)] leading-relaxed">
                    {project.summary || project.description}
                  </p>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <!-- Deck Indicator (spaced comfortably below cards) -->
      <div class="flex items-center justify-center gap-2 mt-6" aria-label="Project deck navigation">
        {featuredProjects.map((_, idx) => (
          <button
            type="button"
            class="deck-dot h-1.5 rounded-full transition-all duration-300 bg-[var(--color-border)] data-[active=true]:bg-[var(--color-accent)] data-[active=true]:w-6 w-2 cursor-pointer"
            data-index={idx}
            aria-label={`Show project ${idx + 1}`}
            data-active={idx === 0 ? "true" : "false"}
          />
        ))}
      </div>
    </div>

    <!-- Desktop Responsive Grid (>= 640px) -->
    <div class="hidden sm:grid sm:grid-cols-2 xl:grid-cols-3 gap-5">
      {featuredProjects.map((project) => (
        <article class="terminal-panel bg-[var(--color-surface)] border border-[var(--color-border)] rounded-lg overflow-hidden group hover:border-[var(--color-accent)] transition-colors flex flex-col h-full">
          <!-- Terminal Window Header -->
          <div class="px-3 py-1.5 bg-[var(--color-surface)] border-b border-[var(--color-border-subtle)] flex items-center justify-between font-mono text-[10px]">
            <div class="flex items-center gap-1">
              <span class="w-2 h-2 rounded-full bg-[#EF4444] opacity-75"></span>
              <span class="w-2 h-2 rounded-full bg-[#F59E0B] opacity-75"></span>
              <span class="w-2 h-2 rounded-full bg-[#10B981] opacity-75"></span>
            </div>
            <span class="text-[var(--color-text-muted)] text-[10px] truncate max-w-[140px]">
              ~/projects/{project.title.toLowerCase().replace(/\s+/g, '-')}
            </span>
          </div>

          <!-- Preview Image -->
          {project.image && (
            <div class="relative aspect-[16/9] overflow-hidden bg-[var(--color-bg)] border-b border-[var(--color-border-subtle)]">
              <img 
                src={project.image} 
                alt={project.imageAlt || project.title}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300"
              />
            </div>
          )}

          <!-- Card Content -->
          <div class="p-4 pb-6 flex flex-col justify-between flex-1">
            <div>
              <div class="flex items-start justify-between gap-2 mb-2">
                <h3 class="font-heading text-sm font-extrabold text-[var(--color-text-primary)] group-hover:text-[var(--color-accent)] transition-colors truncate">
                  {project.title}
                </h3>
                <div class="flex items-center gap-2 font-mono text-[11px] shrink-0">
                  {project.github && project.github !== '#' && (
                    <a 
                      href={project.github} 
                      target="_blank" 
                      rel="noopener noreferrer" 
                      class="text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors"
                    >
                      code ↗
                    </a>
                  )}
                  {project.link && project.link !== '#' && (
                    <a 
                      href={project.link} 
                      target="_blank" 
                      rel="noopener noreferrer" 
                      class="text-[var(--color-accent)] hover:underline"
                    >
                      live ↗
                    </a>
                  )}
                </div>
              </div>
              <p class="font-sans text-xs text-[var(--color-text-secondary)] leading-relaxed">
                {project.summary || project.description}
              </p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Technologies & Tools Highlight -->
  <section class="my-8 sm:my-12 reveal-on-scroll">
    <div class="flex items-center justify-between gap-2 mb-4">
      <div class="flex items-center gap-2">
        <span class="font-mono text-xs text-[var(--color-prompt)] font-bold">~/stack $</span>
        <h2 class="font-heading text-base sm:text-lg font-extrabold tracking-tight text-[var(--color-text-primary)]">
          Technologies & Tools
        </h2>
      </div>
      <a href="/skills" class="font-mono text-xs text-[var(--color-accent)] hover:underline inline-flex items-center gap-1">
        <span>Detailed view</span>
        <span class="ext-arrow">→</span>
      </a>
    </div>

    <div class="terminal-panel p-4 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-md space-y-3">
      {highlightSkillCategories.map((cat) => (
        <div class="flex flex-col sm:flex-row sm:items-baseline gap-1.5 sm:gap-3 text-xs">
          <span class="font-mono text-[11px] text-[var(--color-text-secondary)] font-semibold sm:w-32 shrink-0">
            {cat.name}:
          </span>
          <div class="flex flex-wrap gap-1.5">
            {cat.skills.map((s) => (
              <span class="terminal-badge text-[9px] sm:text-[10px] px-1.5 sm:px-2 py-0.5">
                {s}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Recent Writing Highlight -->
  {recentPosts.length > 0 && (
    <section class="my-8 sm:my-12 reveal-on-scroll">
      <div class="flex items-center justify-between gap-2 mb-4">
        <div class="flex items-center gap-2">
          <span class="font-mono text-xs text-[var(--color-accent-secondary)] font-bold">~/writing $</span>
          <h2 class="font-heading text-base sm:text-lg font-extrabold tracking-tight text-[var(--color-text-primary)]">
            Recent Writings
          </h2>
        </div>
        <a href="/writing" class="font-mono text-xs text-[var(--color-accent)] hover:underline inline-flex items-center gap-1">
          <span>All posts ({allPosts.length})</span>
          <span class="ext-arrow">→</span>
        </a>
      </div>

      <div class="divide-y divide-[var(--color-border-subtle)] border border-[var(--color-border)] rounded-md bg-[var(--color-surface)] p-2 sm:p-3">
        {recentPosts.map((post) => (
          <a 
            href={`/writing/${post.id}`} 
            class="group block p-2.5 rounded-sm hover:bg-[var(--color-border-subtle)] transition-colors"
          >
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
              <h3 class="font-heading text-xs sm:text-sm font-bold text-[var(--color-text-primary)] group-hover:text-[var(--color-accent)] transition-colors">
                {post.data.title}
              </h3>
              <time class="font-mono text-[11px] text-[var(--color-text-muted)] shrink-0">
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
            </div>
            <p class="font-sans text-xs text-[var(--color-text-secondary)] line-clamp-1 mt-1">
              {post.data.description}
            </p>
          </a>
        ))}
      </div>
    </section>
  )}

  <style>
    /* ── Spotlight Card Deck (Mobile Only, < 640px) ── */
    .spotlight-deck {
      position: relative;
      height: 22rem;
      margin-inline: calc(50% - 50vw);
      overflow-x: clip;
      overflow-y: visible;
    }
    @supports not (overflow-x: clip) {
      .spotlight-deck {
        overflow-x: hidden;
      }
    }

    .deck-card {
      position: absolute;
      top: 0.5rem;
      left: 50%;
      width: 14.8rem;
      height: 20rem;
      margin-left: -7.4rem;
      transform-origin: center bottom;
      transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s ease, border-color 0.25s ease;
      will-change: transform;
      outline: none;
    }

    /* Center Spotlight Card */
    .deck-card.is-center {
      transform: translateY(0) rotate(0deg) scale(1);
      z-index: 30;
      box-shadow: 0 16px 36px -12px rgba(0, 0, 0, 0.55), 0 0 0 1px var(--color-border);
      border-color: var(--color-border);
    }
    .deck-card.is-center:hover {
      transform: translateY(-4px) scale(1.015);
      border-color: var(--color-accent);
      box-shadow: 0 20px 40px -14px rgba(245, 158, 11, 0.22), 0 0 0 1px var(--color-accent);
    }

    /* Left Card */
    .deck-card.is-left {
      transform: translateX(-36%) translateY(10px) rotate(-8deg) scale(0.88);
      z-index: 10;
      box-shadow: 0 12px 28px -14px rgba(0, 0, 0, 0.45);
      cursor: pointer;
    }
    .deck-card.is-left:hover {
      transform: translateX(-40%) translateY(3px) rotate(-5deg) scale(0.91);
      z-index: 25;
      border-color: var(--color-accent);
    }

    /* Right Card */
    .deck-card.is-right {
      transform: translateX(36%) translateY(10px) rotate(8deg) scale(0.88);
      z-index: 20;
      box-shadow: 0 12px 28px -14px rgba(0, 0, 0, 0.45);
      cursor: pointer;
    }
    .deck-card.is-right:hover {
      transform: translateX(40%) translateY(3px) rotate(5deg) scale(0.91);
      z-index: 25;
      border-color: var(--color-accent);
    }

    /* Dimming layer on side cards so center pops */
    .deck-card.is-left::after,
    .deck-card.is-right::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: var(--color-bg);
      opacity: 0.45;
      transition: opacity 0.35s ease;
      pointer-events: none;
    }
    .deck-card.is-left:hover::after,
    .deck-card.is-right:hover::after {
      opacity: 0.12;
    }

    /* Only center card's links are interactive */
    .deck-card:not(.is-center) a {
      pointer-events: none;
    }
  </style>

  <!-- Spotlight Deck Interactive Controller Script -->
  <script>
    function setupSpotlightDeck() {
      const deck = document.querySelector<HTMLElement>('[data-deck]');
      if (!deck) return;

      const cards = Array.from(deck.querySelectorAll<HTMLElement>('[data-deck-card]'));
      const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.deck-dot'));

      if (cards.length < 2) return;

      // Ensure all cards are visible
      cards.forEach((c) => {
        c.classList.add('is-revealed');
        c.setAttribute('data-revealed', 'true');
      });

      function syncActiveDot() {
        const centerCard = deck?.querySelector<HTMLElement>('.deck-card.is-center');
        if (!centerCard) return;
        const activeIdx = parseInt(centerCard.getAttribute('data-index') || '0', 10);
        dots.forEach((dot, idx) => {
          dot.setAttribute('data-active', idx === activeIdx ? 'true' : 'false');
        });
      }

      function activateCard(card: HTMLElement) {
        if (card.classList.contains('is-center')) return;

        const currentCenter = deck?.querySelector<HTMLElement>('.deck-card.is-center');
        if (!currentCenter) return;

        const targetSlot = card.classList.contains('is-left') ? 'is-left' : 'is-right';

        currentCenter.classList.remove('is-center');
        currentCenter.classList.add(targetSlot);

        card.classList.remove('is-left', 'is-right');
        card.classList.add('is-center');

        syncActiveDot();
      }

      function activateByIndex(targetIdx: number) {
        const targetCard = cards.find(
          (c) => parseInt(c.getAttribute('data-index') || '-1', 10) === targetIdx
        );
        if (targetCard) activateCard(targetCard);
      }

      function nextCard() {
        const rightCard = deck?.querySelector<HTMLElement>('.deck-card.is-right');
        if (rightCard) activateCard(rightCard);
      }

      function prevCard() {
        const leftCard = deck?.querySelector<HTMLElement>('.deck-card.is-left');
        if (leftCard) activateCard(leftCard);
      }

      cards.forEach((card) => {
        card.onclick = (e) => {
          const target = e.target as HTMLElement;
          if (card.classList.contains('is-center') && target.closest('a')) {
            return;
          }
          e.preventDefault();
          activateCard(card);
        };

        card.onkeydown = (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            const target = e.target as HTMLElement;
            if (card.classList.contains('is-center') && target.closest('a')) {
              return;
            }
            e.preventDefault();
            activateCard(card);
          } else if (e.key === 'ArrowRight') {
            e.preventDefault();
            nextCard();
          } else if (e.key === 'ArrowLeft') {
            e.preventDefault();
            prevCard();
          }
        };
      });

      dots.forEach((dot, idx) => {
        dot.onclick = () => activateByIndex(idx);
      });

      // Touch / Swipe support
      let touchStartX = 0;
      let touchStartY = 0;
      let touchEndX = 0;
      let touchEndY = 0;

      deck.addEventListener(
        'touchstart',
        (e) => {
          touchStartX = e.changedTouches[0].screenX;
          touchStartY = e.changedTouches[0].screenY;
        },
        { passive: true }
      );

      deck.addEventListener(
        'touchend',
        (e) => {
          touchEndX = e.changedTouches[0].screenX;
          touchEndY = e.changedTouches[0].screenY;
          const diffX = touchEndX - touchStartX;
          const diffY = touchEndY - touchStartY;

          if (Math.abs(diffX) > 35 && Math.abs(diffX) > Math.abs(diffY)) {
            if (diffX < 0) {
              nextCard();
            } else {
              prevCard();
            }
          }
        },
        { passive: true }
      );

      syncActiveDot();
    }

    setupSpotlightDeck();
    document.addEventListener('astro:page-load', setupSpotlightDeck);
  </script>
</BaseLayout>

