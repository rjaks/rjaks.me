---
// src/pages/projects.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
---

<BaseLayout 
  title="Projects — Adrian Reforsado (rjaks)" 
  description="Open-source libraries, web applications, developer CLI tools, and software experiments by Adrian Reforsado."
>
  <div class="space-y-6">
    <!-- Terminal Prompt Breadcrumb -->
    <div class="flex items-center gap-2 font-mono text-xs text-[var(--color-prompt)] font-bold">
      <span>rjaks:~$</span>
      <span class="text-[var(--color-text-primary)]">cd ~/projects && ls -la</span>
    </div>

    <div>
      <h1 class="font-heading text-2xl sm:text-3xl font-extrabold tracking-tight text-[var(--color-text-primary)]">
        Projects
      </h1>
      <p class="font-sans text-xs sm:text-sm text-[var(--color-text-secondary)] mt-1.5">
        A directory of software tools, web applications, libraries, and open-source experiments.
      </p>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-6">
      {projects.map((project) => (
        <article class="terminal-panel p-4 sm:p-5 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-md flex flex-col justify-between transition-all hover:border-[var(--color-accent)]">
          <div>
            <div class="flex items-start justify-between gap-2 mb-2">
              <h2 class="font-heading text-sm sm:text-base font-extrabold text-[var(--color-text-primary)]">
                {project.title}
              </h2>
              {project.featured && (
                <span class="font-mono text-[10px] text-[var(--color-accent)] border border-[var(--color-accent)] px-1.5 py-0.5 rounded-xs">
                  featured
                </span>
              )}
            </div>

            <p class="font-sans text-xs text-[var(--color-text-secondary)] leading-relaxed mb-4">
              {project.description}
            </p>
          </div>

          <div class="space-y-3 pt-3 border-t border-[var(--color-border-subtle)]">
            <div class="flex flex-wrap gap-1.5">
              {project.tags.map((tag) => (
                <span class="terminal-badge text-[10px]">
                  {tag}
                </span>
              ))}
            </div>

            <div class="flex items-center justify-between font-mono text-xs pt-1">
              {project.github && project.github !== '#' ? (
                <a 
                  href={project.github} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors inline-flex items-center gap-1"
                >
                  <span>Source</span>
                  <span class="ext-arrow">↗</span>
                </a>
              ) : <span class="text-[var(--color-text-muted)] text-[11px]">Private / Internal</span>}

              {project.link && project.link !== '#' && (
                <a 
                  href={project.link} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="editorial-link font-medium inline-flex items-center gap-1"
                >
                  <span>Live Preview</span>
                  <span class="ext-arrow">↗</span>
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
