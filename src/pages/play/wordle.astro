---
// src/pages/play/wordle.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Wordle — Adrian Reforsado (rjaks)" 
  description="Play terminal-themed Wordle on rjaks.me. Guess the 5-letter word in 6 attempts!"
>
  <div class="space-y-6 max-w-xl mx-auto">
    <!-- Breadcrumb / Header -->
    <div class="flex items-center justify-between font-mono text-xs">
      <div class="flex items-center gap-2 text-[var(--color-prompt)] font-bold">
        <span>rjaks:~$</span>
        <span class="text-[var(--color-text-primary)]">play wordle</span>
      </div>
      <a 
        href="/"
        class="text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors flex items-center gap-1"
      >
        <span>&larr; cd ~</span>
      </a>
    </div>

    <!-- Header info -->
    <div class="text-center space-y-1">
      <h1 class="font-heading text-2xl sm:text-3xl font-extrabold tracking-tight text-[var(--color-text-primary)]">
        Terminal Wordle
      </h1>
      <p class="font-sans text-xs sm:text-sm text-[var(--color-text-secondary)]">
        Guess the hidden 5-letter word in 6 tries.
      </p>
    </div>

    <!-- Game Board Container Placeholder for Phase 2 & 3 -->
    <div id="wordle-root" class="w-full flex flex-col items-center">
      <div class="terminal-panel p-6 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-md text-center text-xs font-mono text-[var(--color-text-secondary)]">
        Loading Wordle...
      </div>
    </div>
  </div>
</BaseLayout>
