---
// src/pages/contact.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { contactLinks } from '../data/contact';
---

<BaseLayout 
  title="Contact — Adrian Reforsado (rjaks)" 
  description="Get in touch with Adrian Reforsado for engineering collaborations, opportunities, or technical inquiries."
>
  <div class="space-y-6">
    <!-- Terminal Prompt Breadcrumb -->
    <div class="flex items-center gap-2 font-mono text-xs text-[var(--color-prompt)] font-bold">
      <span>rjaks:~$</span>
      <span class="text-[var(--color-text-primary)]">contact --list</span>
    </div>

    <div>
      <h1 class="font-heading text-2xl sm:text-3xl font-extrabold tracking-tight text-[var(--color-text-primary)]">
        Get in Touch
      </h1>
      <p class="font-sans text-xs sm:text-sm text-[var(--color-text-secondary)] mt-1.5">
        Feel free to reach out for software engineering inquiries, open-source collaborations, or just to chat tech.
      </p>
    </div>

    <div class="terminal-panel p-5 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-md space-y-4 mt-6">
      <p class="font-sans text-xs sm:text-sm text-[var(--color-text-secondary)] leading-relaxed">
        I'm most responsive via email and active on GitHub. If you'd like to collaborate or have an interesting engineering problem, drop me a line:
      </p>

      <div class="space-y-2 pt-2">
        {contactLinks.map((link) => (
          <div class="flex items-center justify-between p-2.5 rounded-sm bg-[var(--color-bg)] border border-[var(--color-border-subtle)] font-mono text-xs">
            <span class="text-[var(--color-text-primary)] font-semibold">{link.label}</span>
            <a 
              href={link.href} 
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              class="text-[var(--color-accent)] hover:underline inline-flex items-center gap-1"
            >
              <span>{link.href.replace('mailto:', '')}</span>
              <span class="ext-arrow">{link.external ? '↗' : '→'}</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
