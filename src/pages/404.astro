---
// src/pages/404.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="404: Not Found — Adrian Reforsado" 
  description="404: command not found. This path does not exist."
>
  <div class="py-16 sm:py-24 text-center space-y-4">
    <div class="inline-flex items-center gap-2 font-mono text-xs text-[var(--color-prompt)] font-bold">
      <span>rjaks:~$</span>
      <span class="text-red-400">404 route_not_found</span>
    </div>

    <h1 class="font-heading text-3xl sm:text-4xl font-extrabold tracking-tight text-[var(--color-text-primary)]">
      Page Not Found
    </h1>

    <p class="font-sans text-xs sm:text-sm text-[var(--color-text-secondary)] max-w-sm mx-auto">
      The file or command you are looking for has been moved or deleted from the filesystem.
    </p>

    <div class="pt-4 flex items-center justify-center gap-3 font-mono text-xs">
      <a 
        href="/" 
        class="inline-flex items-center gap-2 px-3 py-1.5 rounded-sm bg-[var(--color-surface)] border border-[var(--color-accent)] text-[var(--color-accent)] hover:bg-[var(--color-accent)] hover:text-[var(--color-bg)] transition-colors"
      >
        <span>cd ~ (Go Home)</span>
        <kbd>h</kbd>
      </a>
    </div>
  </div>
</BaseLayout>
