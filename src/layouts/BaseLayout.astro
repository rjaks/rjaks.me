---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import KeyboardShortcuts from '../components/KeyboardShortcuts.astro';

interface Props {
  title: string;
  description?: string;
}

const { 
  title = 'Adrian Reforsado (rjaks)', 
  description = 'Personal website and portfolio of Adrian Reforsado (rjaks) — Software Engineer & CS Student.' 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Inline Theme Script to prevent flash -->
    <script is:inline>
      (function() {
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
        } else {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--color-bg)] text-[var(--color-text-primary)]">
    <Navbar />
    <main class="container-custom flex-1 py-6 sm:py-10">
      <slot />
    </main>
    <Footer />
    <KeyboardShortcuts />
  </body>
</html>

