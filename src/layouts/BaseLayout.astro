---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import KeyboardShortcuts from '../components/KeyboardShortcuts.astro';
import WordleModal from '../components/game/WordleModal.astro';

interface Props {
  title: string;
  description?: string;
}

const { 
  title = 'Adrian Reforsado (rjaks)', 
  description = 'Personal website and portfolio of Adrian Reforsado (rjaks) — Software Engineer & CS Student.' 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
    
    <!-- Inline Theme Script to prevent flash -->
    <script is:inline>
      function applyTheme() {
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
        } else {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--color-bg)] text-[var(--color-text-primary)]">
    <!-- Top Route Progress Bar -->
    <div 
      id="route-progress-bar" 
      class="fixed top-0 left-0 h-[2px] w-0 bg-[var(--color-accent)] z-50 pointer-events-none transition-all duration-200 ease-out opacity-0 shadow-[0_0_8px_var(--color-accent)]"
      aria-hidden="true"
    ></div>

    <Navbar />
    <div class="flex-1 w-full lg:pl-60 xl:pl-64 flex flex-col">
      <main class="max-w-4xl w-full mx-auto px-4 sm:px-6 lg:px-8 pt-14 sm:pt-20 md:pt-28 pb-16 sm:pb-24 flex-1 min-w-0">
        <slot />
      </main>
    </div>
    <div class="lg:hidden">
      <Footer />
    </div>
    <KeyboardShortcuts />
    <WordleModal />

    <!-- Route Progress Bar Controller -->
    <script>
      let progressBar: HTMLElement | null = null;
      let progressTimer: number | undefined;

      function getBar() {
        if (!progressBar || !document.body.contains(progressBar)) {
          progressBar = document.getElementById('route-progress-bar');
        }
        return progressBar;
      }

      function startProgress() {
        const bar = getBar();
        if (!bar) return;
        window.clearTimeout(progressTimer);
        bar.style.transition = 'width 250ms cubic-bezier(0.16, 1, 0.3, 1), opacity 100ms ease';
        bar.style.opacity = '1';
        bar.style.width = '35%';

        progressTimer = window.setTimeout(() => {
          if (bar.style.opacity === '1') {
            bar.style.width = '75%';
          }
        }, 120);
      }

      function finishProgress() {
        const bar = getBar();
        if (!bar) return;
        window.clearTimeout(progressTimer);
        bar.style.transition = 'width 120ms ease-out, opacity 180ms ease 80ms';
        bar.style.width = '100%';
        bar.style.opacity = '0';

        setTimeout(() => {
          if (bar.style.opacity === '0') {
            bar.style.transition = 'none';
            bar.style.width = '0%';
          }
        }, 320);
      }

      document.addEventListener('astro:before-preparation', startProgress);
      document.addEventListener('astro:page-load', finishProgress);
    </script>
  </body>
</html>

