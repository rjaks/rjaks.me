---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import KeyboardShortcuts from '../components/KeyboardShortcuts.astro';
import WordleModal from '../components/game/WordleModal.astro';
import ChatModal from '../components/chat/ChatModal.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: {
    publishedTime: string;
    modifiedTime?: string;
    tags?: string[];
  };
  noindex?: boolean;
}

const { 
  title = 'Adrian Reforsado (rjaks) — Software Engineer & Developer', 
  description = 'Personal website and portfolio of Adrian Reforsado (rjaks) — Software Engineer & CS Student.',
  image = '/images/og-image.png',
  article,
  noindex = false,
} = Astro.props;

const siteOrigin = (Astro.site ? Astro.site.toString() : 'https://rjaks.me').replace(/\/+$/, '');
const canonicalURL = new URL(Astro.url.pathname, siteOrigin);
const socialImageURL = new URL(image, siteOrigin);
const isArticle = Boolean(article);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteOrigin}/#website`,
      'url': `${siteOrigin}/`,
      'name': 'Adrian Reforsado',
      'alternateName': ['rjaks', 'Adrian Reforsado (rjaks)'],
      'description': 'Personal website and portfolio of Adrian Reforsado (rjaks) — Software Engineer & CS Student.',
      'inLanguage': 'en-US',
      'publisher': {
        '@id': `${siteOrigin}/#person`,
      },
    },
    {
      '@type': 'Person',
      '@id': `${siteOrigin}/#person`,
      'name': 'Adrian Reforsado',
      'alternateName': ['rjaks', 'Adrian Reforsado (rjaks)', 'adreforsado'],
      'url': `${siteOrigin}/`,
      'image': `${siteOrigin}/images/avatar.png`,
      'jobTitle': 'Software Engineer',
      'description': 'CS student and full-stack developer building fast, reliable software for real-world problems.',
      'email': 'mailto:contact@rjaks.me',
      'sameAs': [
        'https://github.com/rjaks',
        'https://linkedin.com/in/adreforsado',
      ],
      'knowsAbout': [
        'Software Engineering',
        'Full-Stack Web Development',
        'Computer Science',
        'TypeScript',
        'JavaScript',
        'Python',
        'Astro',
        'Tailwind CSS',
        'React',
        'Node.js',
      ],
    },
    {
      '@type': isArticle ? 'ItemPage' : 'WebPage',
      '@id': `${canonicalURL.href}#webpage`,
      'url': canonicalURL.href,
      'name': title,
      'description': description,
      'isPartOf': {
        '@id': `${siteOrigin}/#website`,
      },
      'about': {
        '@id': `${siteOrigin}/#person`,
      },
      'inLanguage': 'en-US',
    },
    ...(isArticle && article
      ? [
          {
            '@type': 'BlogPosting',
            '@id': `${canonicalURL.href}#article`,
            'isPartOf': {
              '@id': `${siteOrigin}/#website`,
            },
            'author': {
              '@id': `${siteOrigin}/#person`,
            },
            'headline': title.split(' — ')[0],
            'description': description,
            'datePublished': article.publishedTime,
            'dateModified': article.modifiedTime || article.publishedTime,
            'mainEntityOfPage': canonicalURL.href,
            'inLanguage': 'en-US',
            'image': socialImageURL.href,
            'keywords': article.tags?.join(', '),
          },
        ]
      : []),
  ],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Adrian Reforsado" />
    <meta name="creator" content="Adrian Reforsado" />
    <meta name="publisher" content="Adrian Reforsado" />
    <meta name="keywords" content="Adrian Reforsado, rjaks, Adrian Reforsado rjaks, adreforsado, Software Engineer, Full-Stack Developer, CS Student, Web Developer, Portfolio" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Search Engine Crawlers & Indexing -->
    <meta 
      name="robots" 
      content={noindex ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} 
    />
    <meta 
      name="googlebot" 
      content={noindex ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} 
    />

    <!-- Open Graph / Social Media -->
    <meta property="og:site_name" content="Adrian Reforsado" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:type" content={isArticle ? "article" : "website"} />
    <meta property="og:image" content={socialImageURL.href} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    {isArticle && article && (
      <>
        <meta property="article:published_time" content={article.publishedTime} />
        {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
        <meta property="article:author" content="Adrian Reforsado" />
        {article.tags?.map((tag: string) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL.href} />
    <meta name="twitter:image:alt" content={title} />
    <meta name="twitter:creator" content="@rjaks" />

    <!-- Favicons & App Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />

    <!-- Schema.org JSON-LD Structured Data for Google Entity / Knowledge Graph -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    
    <!-- Google Fonts for Geist, Geist Mono, and Space Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      rel="stylesheet" 
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=Geist+Mono:wght@400;500;600;700;800&family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap" 
    />

    <ClientRouter />
    
    <!-- Inline Theme Script to prevent flash -->
    <script is:inline>
      function applyTheme() {
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
        } else {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
    
    <!-- Noscript fallback for reveal animations -->
    <noscript>
      <style>
        .reveal-on-scroll {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--color-bg)] text-[var(--color-text-primary)]">
    <!-- Top Route Progress Bar -->
    <div 
      id="route-progress-bar" 
      class="fixed top-0 left-0 h-[2px] w-0 bg-[var(--color-accent)] z-50 pointer-events-none transition-all duration-200 ease-out opacity-0 shadow-[0_0_8px_var(--color-accent)]"
      aria-hidden="true"
    ></div>

    <!-- Terminal Background Dot Matrix Layer -->
    <div class="terminal-bg-grid" aria-hidden="true"></div>

    <Navbar />
    <div class="flex-1 w-full lg:pl-60 xl:pl-64 flex flex-col min-h-screen relative z-10">
      <main class="max-w-4xl w-full mx-auto px-4 sm:px-6 lg:px-8 pt-16 sm:pt-20 md:pt-24 pb-12 sm:pb-16 flex-1 min-w-0">
        <slot />
      </main>
    </div>
    <KeyboardShortcuts />
    <WordleModal />
    <ChatModal />

    <!-- Route Progress Bar Controller -->
    <script>
      let progressBar: HTMLElement | null = null;
      let progressTimer: number | undefined;

      function getBar() {
        if (!progressBar || !document.body.contains(progressBar)) {
          progressBar = document.getElementById('route-progress-bar');
        }
        return progressBar;
      }

      function startProgress() {
        const bar = getBar();
        if (!bar) return;
        window.clearTimeout(progressTimer);
        bar.style.transition = 'width 250ms cubic-bezier(0.16, 1, 0.3, 1), opacity 100ms ease';
        bar.style.opacity = '1';
        bar.style.width = '35%';

        progressTimer = window.setTimeout(() => {
          if (bar.style.opacity === '1') {
            bar.style.width = '75%';
          }
        }, 120);
      }

      function finishProgress() {
        const bar = getBar();
        if (!bar) return;
        window.clearTimeout(progressTimer);
        bar.style.transition = 'width 120ms ease-out, opacity 180ms ease 80ms';
        bar.style.width = '100%';
        bar.style.opacity = '0';

        setTimeout(() => {
          if (bar.style.opacity === '0') {
            bar.style.transition = 'none';
            bar.style.width = '0%';
          }
        }, 320);
      }

      document.addEventListener('astro:before-preparation', startProgress);
      document.addEventListener('astro:page-load', finishProgress);

      // Scroll Reveal Observer
      function setupScrollReveal() {
        const targets = document.querySelectorAll<HTMLElement>('.reveal-on-scroll:not([data-revealed])');
        if (!targets.length) return;

        if (!('IntersectionObserver' in window)) {
          targets.forEach((el) => {
            el.classList.add('is-revealed');
            el.setAttribute('data-revealed', 'true');
          });
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const el = entry.target as HTMLElement;
                el.classList.add('is-revealed');
                el.setAttribute('data-revealed', 'true');
                observer.unobserve(el);
              }
            });
          },
          {
            threshold: 0.08,
            rootMargin: '0px 0px -20px 0px',
          }
        );

        targets.forEach((el) => observer.observe(el));
      }

      document.addEventListener('astro:page-load', setupScrollReveal);
    </script>
  </body>
</html>

