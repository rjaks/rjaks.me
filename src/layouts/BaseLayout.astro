---
import '../styles/global.css';
import MascotWidget from '../components/MascotWidget.astro';

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = 'Portfolio and personal website of Adrian Leonidas Reforsado (rjaks).' 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.setAttribute('data-theme', 'dark');
      } else {
        document.documentElement.removeAttribute('data-theme');
      }
    </script>
  </head>
  <body>
    <slot />
    <MascotWidget />

    <!-- Paw Print Click Trail (Desktop pointer only) -->
    <script>
      const isTouch = window.matchMedia('(pointer: coarse)').matches;
      if (!isTouch) {
        document.addEventListener('mousedown', (e) => {
          // Don't spawn on interactive elements if user is selecting or interacting with mascot
          const target = e.target as HTMLElement;
          if (target.closest('#mascot-widget')) return;

          const paw = document.createElement('div');
          paw.className = 'paw-stamp';
          paw.style.left = `${e.clientX}px`;
          paw.style.top = `${e.clientY}px`;
          
          // Random slight rotation for natural walking trail feel
          const rot = Math.floor(Math.random() * 40) - 20;
          paw.style.setProperty('--rot', `${rot}deg`);
          
          paw.innerHTML = `
            <svg viewBox="0 0 24 24" width="100%" height="100%" fill="currentColor">
              <ellipse cx="12" cy="15" rx="5" ry="4.2"/>
              <circle cx="6.5" cy="8.5" r="2.2"/>
              <circle cx="10.2" cy="5.8" r="2.2"/>
              <circle cx="14" cy="5.8" r="2.2"/>
              <circle cx="17.5" cy="8.5" r="2.2"/>
            </svg>
          `;
          
          document.body.appendChild(paw);
          
          // Clean up element after animation finishes
          setTimeout(() => {
            paw.remove();
          }, 600);
        });
      }
    </script>
  </body>
</html>
